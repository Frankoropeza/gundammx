---
interface Props {
  origen: 'distribuidor_autorizado' | 'revende_original' | 'importacion_directa' | 'mixto' | 'no_verificado';
}
const { origen } = Astro.props;
// Nunca "oficial", "autorizado por Bandai" ni "partner".
const mapa = {
  distribuidor_autorizado: { texto: 'Distribuidor autorizado', clase: 'tag-verify' },
  revende_original:        { texto: 'Revende original',        clase: 'tag' },
  importacion_directa:     { texto: 'Importación directa',     clase: 'tag' },
  mixto:                   { texto: 'Origen mixto',            clase: 'tag-signal' },
  no_verificado:           { texto: 'Origen no verificado',    clase: 'tag-signal' },
} as const;
const s = mapa[origen];
---

<span class={s.clase}>{s.texto}</span>

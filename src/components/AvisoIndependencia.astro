---
import { AVISO_INDEPENDENCIA, ENLACES_OFICIALES } from '@config/site';
interface Props { compacto?: boolean; borde?: boolean }
const { compacto = false, borde = true } = Astro.props;
---

<aside class:list={['text-ink-2', borde && 'border-t border-line pt-6', compacto ? 'text-xs' : 'text-sm']} aria-label="Aviso de independencia">
  <p class="max-w-prose text-pretty">{AVISO_INDEPENDENCIA}</p>
  <p class="mt-2">
    {ENLACES_OFICIALES.map((e, i) => (
      <>
        {i > 0 && <span class="mx-2 text-ink-3" aria-hidden="true">·</span>}
        <a class="link" href={e.url} rel="nofollow noopener" target="_blank">{e.nombre}</a>
      </>
    ))}
  </p>
</aside>

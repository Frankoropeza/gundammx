---
import type { CollectionEntry } from 'astro:content';
import { fechaCorta } from '@lib/precio';
interface Props { nota: CollectionEntry<'noticias'>; grande?: boolean }
const { nota, grande = false } = Astro.props;
const d = nota.data;
---

<article class="group relative flex flex-col gap-3 border-t border-line pt-5">
  <p class="flex items-center gap-3 font-mono text-xs text-ink-3">
    <span class="uppercase tracking-wider">{d.categoria}</span>
    <time datetime={d.fecha.toISOString()}>{fechaCorta(d.fecha)}</time>
  </p>
  <h3 class:list={['display leading-tight group-hover:text-accent', grande ? 'text-3xl' : 'text-xl']}>
    <a href={`/noticias/${nota.id}/`} class="after:absolute after:inset-0 after:content-['']">{d.titulo}</a>
  </h3>
  <p class="text-sm text-ink-2 text-pretty">{d.descripcion}</p>
</article>

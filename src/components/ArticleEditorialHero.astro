---
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
import Plegable from '@components/Plegable.astro';

interface Props {
  categoria: string;
  fecha: string;
  actualizada?: string;
  lectura: number;
  titulo: string;
  resumen: string;
  autor: string;
  nivel: string;
  referencias: number;
  aprendizajes: string[];
  etiquetas: { texto: string; href?: string }[];
  acciones: { texto: string; href: string; principal?: boolean }[];
  imagen?: ImageMetadata;
  imagenAlt?: string;
  imagenCredito?: string;
  codigo: string;
}

const {
  categoria, fecha, actualizada, lectura, titulo, resumen, autor, nivel, referencias,
  aprendizajes, etiquetas, acciones, imagen, imagenAlt, imagenCredito, codigo,
} = Astro.props;
---

<header class="border-b border-line" data-article-template="editorial-pilot">
  <div class="grid-page py-12 md:py-16">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="flex flex-col justify-center lg:col-span-7">
        <p class="class-line">
          <span>{categoria}</span>
          <span class="whitespace-nowrap">{fecha}</span>
          <span class="hidden whitespace-nowrap sm:inline">{lectura} min</span>
        </p>
        <h1 class="display mt-7 text-[2.55rem] leading-[1.04] md:text-[3.35rem] xl:text-[4rem]">{titulo}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-ink-2 text-pretty">{resumen}</p>
        <MetadataRow
          class="mt-8"
          items={[
            { etiqueta: 'Autoría', valor: autor },
            { etiqueta: 'Nivel', valor: nivel },
            { etiqueta: 'Referencias', valor: String(referencias) },
            ...(actualizada ? [{ etiqueta: 'Actualizado', valor: actualizada }] : []),
          ]}
        />
        <div class="mt-8 flex flex-wrap gap-3">
          {acciones.map((accion) => (
            <a href={accion.href} class={accion.principal ? 'btn-primary' : 'btn-secondary'}>{accion.texto}</a>
          ))}
        </div>
      </div>

      <div class="flex flex-col justify-center lg:col-span-5 lg:border-l lg:border-line lg:pl-12">
        <Plegable titulo="Qué aprenderás" nivel="p" class="max-md:border-y max-md:border-line">
          <ol class="mt-6 grid gap-4 max-md:pb-5">
            {aprendizajes.map((aprendizaje, index) => (
              <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-relaxed text-ink-2">
                <span class="folio border-t border-brand pt-2 text-accent">{String(index + 1).padStart(2, '0')}</span>
                <span>{aprendizaje}</span>
              </li>
            ))}
          </ol>
        </Plegable>
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="mr-1 rotulo text-ink-3">Claves</span>
          {etiquetas.map((etiqueta) => etiqueta.href
            ? <a href={etiqueta.href} class="tag transition-colors hover:border-ink hover:text-ink">{etiqueta.texto}</a>
            : <span class="tag">{etiqueta.texto}</span>
          )}
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-5 md:mt-14 md:pt-6">
      <Figura
        src={imagen}
        alt={imagenAlt}
        credito={imagenCredito}
        codigo={codigo}
        prioridad
        ratio="aspect-[16/9] md:aspect-[16/7]"
        sizes="100vw"
      />
    </div>
  </div>
</header>

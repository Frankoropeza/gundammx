---
import SearchBar from '@components/SearchBar.astro';

interface Props {
  sello: { archivo: string; actualizado: string };
  titulo: string;
  destaque: string;
  entrada: string;
  busqueda: { sugerencia: string };
  acciones: { texto: string; href: string; principal?: boolean }[];
  credenciales: { cifra: string; etiqueta: string }[];
  firma: string;
  contexto: { titulo: string; parrafos: string[]; masBuscado: { texto: string; href: string }[] };
  lectura: { eyebrow: string; titulo: string; resumen: string; href: string; meta: string };
}
const { sello, titulo, destaque, entrada, busqueda, acciones, credenciales, firma, contexto, lectura } = Astro.props;
---
<section class="border-b border-line" aria-labelledby="hero-h">
  <div class="grid-page grid gap-12 py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
    <div class="lg:col-span-7">
      <p class="class-line">
        <span class="whitespace-nowrap">{sello.archivo}</span>
        <span class="hidden whitespace-nowrap sm:inline">Actualizado {sello.actualizado}</span>
      </p>

      <h1 id="hero-h" class="display mt-7 text-[2.6rem] leading-[1.04] md:text-[3.4rem] xl:text-[4.1rem] text-balance">
        {titulo} <em class="italic text-ink-2">{destaque}</em>
      </h1>

      <p class="mt-7 max-w-[52ch] text-lg leading-relaxed text-ink-2 text-pretty">{entrada}</p>

      <div class="mt-9 max-w-2xl">
        <SearchBar placeholder="Busca una serie, un mobile suit, un kit o una tienda" />
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{busqueda.sugerencia}</p>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        {acciones.map((a) => (
          <a href={a.href} class:list={[a.principal ? 'btn-primary' : 'btn-secondary']}>{a.texto}</a>
        ))}
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8 sm:grid-cols-4">
        {credenciales.map((c) => (
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{c.etiqueta}</dt>
            <dd class="display mt-2 text-2xl">{c.cifra}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-6 max-w-[60ch] text-sm text-ink-3 text-pretty">{firma}</p>
    </div>

    <div class="lg:col-span-5 lg:border-l lg:border-line lg:pl-12">
      <p class="class-line">{contexto.titulo}</p>
      <div class="mt-6 space-y-5">
        {contexto.parrafos.map((t) => (
          <p class="hero-copy text-[0.95rem] leading-relaxed text-ink-2 text-pretty"><Fragment set:html={t} /></p>
        ))}
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Más buscado</span>
        {contexto.masBuscado.map((e) => (
          <a href={e.href} class="tag transition-colors hover:border-ink hover:text-ink">{e.texto}</a>
        ))}
      </div>

      <article class="group relative mt-10 border-t border-line pt-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{lectura.eyebrow}</p>
        <h2 class="display mt-3 text-2xl leading-tight">
          <a href={lectura.href} class="after:absolute after:inset-0 after:content-['']">{lectura.titulo}</a>
        </h2>
        <p class="mt-3 text-sm text-ink-2 text-pretty">{lectura.resumen}</p>
        <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{lectura.meta}</p>
      </article>
    </div>
  </div>
</section>

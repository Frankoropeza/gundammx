---
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
interface Props {
  eyebrow: string; titulo: string; intro: string; href: string; cta: string;
  codigo: string; metadata: { etiqueta: string; valor: string; href?: string }[];
  imagen?: ImageMetadata; imagenAlt?: string;
}
const { eyebrow, titulo, intro, href, cta, codigo, metadata, imagen, imagenAlt } = Astro.props;
---
<section class="border-b border-line" aria-labelledby="hero-h">
  <div class="grid-page grid gap-10 py-12 lg:grid-cols-12 lg:gap-14 lg:py-20">
    <div class="order-2 flex flex-col justify-between lg:order-1 lg:col-span-5">
      <div>
        <p class="class-line">{eyebrow}</p>
        <h1 id="hero-h" class="display mt-6 text-4xl md:text-5xl xl:text-6xl text-balance">{titulo}</h1>
        <p class="mt-6 max-w-prose text-lg text-ink-2 text-pretty">{intro}</p>
      </div>
      <div class="mt-10">
        <MetadataRow items={metadata} />
        <a href={href} class="btn-primary mt-8">{cta}</a>
      </div>
    </div>
    <div class="order-1 lg:order-2 lg:col-span-7">
      <Figura src={imagen} alt={imagenAlt} codigo={codigo} prioridad ratio="aspect-[16/10]" />
    </div>
  </div>
</section>

---
import MetadataRow from '@components/MetadataRow.astro';
interface Props {
  eyebrow: string; titulo: string; intro: string; href: string; cta: string;
  metadata: { etiqueta: string; valor: string; href?: string }[];
  contexto: { titulo: string; parrafos: string[]; enlaces?: { texto: string; href: string }[] };
}
const { eyebrow, titulo, intro, href, cta, metadata, contexto } = Astro.props;
---
<section class="border-b border-line" aria-labelledby="hero-h">
  <div class="grid-page grid gap-12 py-12 lg:grid-cols-12 lg:gap-16 lg:py-20">
    <div class="lg:col-span-7">
      <div>
        <p class="class-line">{eyebrow}</p>
        <h1 id="hero-h" class="display mt-6 text-4xl md:text-5xl xl:text-[4.25rem] xl:leading-[0.98] text-balance">{titulo}</h1>
        <p class="mt-6 max-w-[46ch] text-lg text-ink-2 text-pretty">{intro}</p>
      </div>
      <div class="mt-12 lg:mt-16">
        <MetadataRow items={metadata} />
        <a href={href} class="btn-primary mt-8">{cta}</a>
      </div>
    </div>

    <div class="lg:col-span-5 lg:border-l lg:border-line lg:pl-10">
      <p class="class-line">{contexto.titulo}</p>
      <div class="mt-6 space-y-5">
        {contexto.parrafos.map((t) => <p class="text-[0.95rem] leading-relaxed text-ink-2 text-pretty">{t}</p>)}
      </div>
      {contexto.enlaces && (
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {contexto.enlaces.map((e) => (
            <li><a href={e.href} class="link font-mono text-[11px] uppercase tracking-[0.14em]">{e.texto}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

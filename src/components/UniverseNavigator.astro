---
import type { CollectionEntry } from 'astro:content';
interface Props { universos: (CollectionEntry<'universes'> & { totalSeries: number })[] }
const { universos } = Astro.props;
---
<section class="grid-page py-16" aria-labelledby="univ-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="class-line">Explorador</p>
      <h2 id="univ-h" class="display mt-3 text-3xl md:text-4xl">Siete calendarios, un universo</h2>
      <p class="mt-3 max-w-prose text-ink-2 text-pretty">Gundam no es una sola historia: son varias líneas temporales independientes. Elige por dónde entrar.</p>
    </div>
    <a href="/cronologia/" class="link text-sm">¿En qué orden verlas?</a>
  </div>

  <ol class="mt-10 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4">
    {universos.map((u, i) => (
      <li class:list={['card p-6', i === 0 && 'sm:col-span-2']}>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-ink-2">{u.data.abreviatura.toUpperCase()}</span>
        <h3 class="display mt-7 text-2xl">
          <a href={`/universos/${u.id}/`} class="link-quiet">{u.data.nombre}</a>
        </h3>
        <p class="mt-1 font-mono text-xs text-ink-3">{u.data.periodo}</p>
        <p class:list={['mt-4 text-sm text-ink-2 text-pretty', i === 0 && 'max-w-prose']}>{u.data.introduccion}</p>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{u.totalSeries} {u.totalSeries === 1 ? 'obra' : 'obras'} en el archivo</p>
      </li>
    ))}
  </ol>
</section>

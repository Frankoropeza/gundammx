---
import { SITE, NAV } from '@config/site';
const ruta = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-base-line bg-base-bg/95 backdrop-blur">
  <nav class="contenedor flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-xl font-bold tracking-wide">
        <span class="text-ink">GUNDAM</span><span class="text-accent">MX</span>
      </span>
      <span class="hidden text-xs text-ink-faint sm:inline">{SITE.descriptor}</span>
    </a>

    <button
      id="menu-btn"
      class="p-2 text-ink-muted md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <ul class="hidden items-center gap-5 md:flex">
      {NAV.map((i) => (
        <li>
          <a
            href={i.href}
            class:list={[
              'text-sm transition-colors hover:text-accent',
              ruta.startsWith(i.href) ? 'text-accent' : 'text-ink-muted',
            ]}
          >{i.texto}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="menu-movil" class="border-t border-base-line md:hidden" hidden>
    <ul class="contenedor space-y-1 py-3">
      {NAV.map((i) => (
        <li><a href={i.href} class="block py-2 text-sm text-ink-muted hover:text-accent">{i.texto}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-movil');
  btn?.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    if (menu) menu.hidden = abierto;
  });
</script>

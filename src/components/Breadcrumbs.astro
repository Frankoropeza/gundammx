---
interface Props { items: { nombre: string; href: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Ruta" class="grid-page pt-6" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-3">
    <li><a href="/" class="hover:text-ink">Inicio</a></li>
    {items.map((i, n) => (
      <>
        <li aria-hidden="true">/</li>
        <li>
          {n === items.length - 1
            ? <span class="text-ink-2" aria-current="page">{i.nombre}</span>
            : <a href={i.href} class="hover:text-ink">{i.nombre}</a>}
        </li>
      </>
    ))}
  </ol>
</nav>

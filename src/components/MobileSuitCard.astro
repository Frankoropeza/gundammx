---
import type { CollectionEntry } from 'astro:content';
import { UNIVERSOS_META } from '@config/site';
import Figura from '@components/Figura.astro';
interface Props { ms: CollectionEntry<'mobile-suits'>; faccion?: string; piloto?: string; folio?: number }
const { ms, faccion, piloto, folio } = Astro.props;
---
<article class="card group relative">
  <Figura src={ms.data.imagen} alt={ms.data.imagen_alt} codigo={ms.data.codigo} ratio="aspect-[4/3]" />
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between">
      <span class="font-mono text-sm tracking-wide text-ink">{ms.data.designacion}</span>
      {folio !== undefined && <span class="folio">{String(folio).padStart(2, '0')}</span>}
    </div>
    <h3 class="display mt-2 text-2xl leading-tight">
      <a href={`/mobile-suits/${ms.id}/`} class="after:absolute after:inset-0 after:content-['']">{ms.data.nombre}</a>
    </h3>
    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
      <div><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">Universo</dt><dd class="text-ink-2">{UNIVERSOS_META[ms.data.universo].nombre}</dd></div>
      <div><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">Facción</dt><dd class="text-ink-2">{faccion ?? ms.data.faccion}</dd></div>
      {piloto && <div class="col-span-2"><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-3">Piloto</dt><dd class="text-ink-2">{piloto}</dd></div>}
    </dl>
    <p class="mt-auto pt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3 group-hover:text-ink">Ficha completa →</p>
  </div>
</article>

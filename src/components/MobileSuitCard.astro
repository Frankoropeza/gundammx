---
import type { CollectionEntry } from 'astro:content';
import { UNIVERSOS_META } from '@config/site';
import Figura from '@components/Figura.astro';
/**
 * `compacta`: para listados completos (no rieles). Por debajo de 640 px la tarjeta pasa a fila
 * —miniatura de 7.5rem a la izquierda, datos a la derecha— y el archivo de 37 fichas deja de
 * medir 28 pantallas. Desde `sm` es idéntica a la tarjeta normal.
 */
interface Props { ms: CollectionEntry<'mobile-suits'>; faccion?: string; piloto?: string; folio?: number; compacta?: boolean }
const { ms, faccion, piloto, folio, compacta = false } = Astro.props;
const sizes = compacta
  ? '(min-width: 1536px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 7.5rem'
  : '(min-width: 1536px) 25vw, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 84vw';
---
<article class:list={['card group relative', compacta && 'max-sm:grid max-sm:grid-cols-[7.5rem_1fr] max-sm:items-start']}>
  <Figura src={ms.data.imagen} alt={ms.data.imagen_alt} codigo={ms.data.codigo} ratio="aspect-[4/3]" sizes={sizes} class={compacta ? 'max-sm:border-y-0 max-sm:border-l-0' : ''} />
  <div class:list={['flex flex-1 flex-col p-6', compacta && 'max-sm:p-4']}>
    <div class="flex items-center justify-between gap-3">
      <span class:list={['font-mono tracking-wide text-ink', compacta ? 'text-xs sm:text-sm' : 'text-sm']}>{ms.data.designacion}</span>
      {folio !== undefined && <span class="folio">{String(folio).padStart(2, '0')}</span>}
    </div>
    <h3 class:list={['display leading-tight', compacta ? 'mt-1 text-xl sm:mt-2 sm:text-2xl sm:leading-tight' : 'mt-2 text-2xl']}>
      <a href={`/mobile-suits/${ms.id}/`} class="after:absolute after:inset-0 after:content-['']">{ms.data.nombre}</a>
    </h3>
    <dl class:list={['grid grid-cols-2 gap-x-4 gap-y-2 text-sm', compacta ? 'mt-2 max-sm:gap-y-1 sm:mt-4' : 'mt-4']}>
      <div><dt class="rotulo text-ink-3">Universo</dt><dd class="text-ink-2">{UNIVERSOS_META[ms.data.universo].nombre}</dd></div>
      <div><dt class="rotulo text-ink-3">Facción</dt><dd class="text-ink-2">{faccion ?? ms.data.faccion}</dd></div>
      {piloto && <div class="col-span-2"><dt class="rotulo text-ink-3">Piloto</dt><dd class="text-ink-2">{piloto}</dd></div>}
    </dl>
    <p class:list={['mt-auto pt-4 rotulo text-ink-3 group-hover:text-ink', compacta && 'max-sm:hidden']}>Ficha completa →</p>
  </div>
</article>

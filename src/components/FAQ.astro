---
/**
 * Acordeón nativo con <details>: accesible y funcional sin JavaScript.
 * El schema FAQPage lo emite la página que lo usa (schemaFAQ), con los mismos items.
 */
interface Props { items: { pregunta: string; respuesta: string }[]; titulo?: string }
const { items, titulo = 'Preguntas frecuentes' } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="faq-h">
    <h2 id="faq-h" class="display text-2xl">{titulo}</h2>
    <div class="mt-5 divide-y divide-line border-t border-line">
      {items.map((i) => (
        <details class="group py-4">
          <summary class="flex min-h-11 items-center justify-between gap-6 text-base font-medium text-ink">
            <span>{i.pregunta}</span>
            <span class="font-mono text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-prose text-sm text-ink-2 text-pretty">{i.respuesta}</p>
        </details>
      ))}
    </div>
  </section>
)}

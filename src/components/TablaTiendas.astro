---
import type { CollectionEntry } from 'astro:content';
import { GRADOS, type GradoId } from '@config/site';
import { nombreEstado } from '@lib/estados';
interface Props { tiendas: CollectionEntry<'tiendas'>[] }
const { tiendas } = Astro.props;
const etiquetas = (g: GradoId[]) =>
  [...g].sort((a, b) => GRADOS[a].orden - GRADOS[b].orden).map((x) => GRADOS[x].etiqueta).join(' ');
---

<div class="table-scroll">
  <table>
    <caption class="sr-only">Comparativa de tiendas</caption>
    <thead>
      <tr>
        <th scope="col">Tienda</th><th scope="col">Ubicación</th><th scope="col">Grados</th>
        <th scope="col">Envío</th><th scope="col">Preventa</th><th scope="col">Verificación</th>
      </tr>
    </thead>
    <tbody>
      {tiendas.map((t) => (
        <tr>
          <td><a href={`/tienda/${t.id}/`} class="link-quiet font-medium">{t.data.nombre}</a></td>
          <td class="text-ink-2">{t.data.sucursales.length ? [...new Set(t.data.sucursales.map((s) => `${s.ciudad}, ${nombreEstado(s.estado)}`))].join(' · ') : 'En línea'}</td>
          <td class="font-mono text-xs text-ink-2">{etiquetas(t.data.grados) || '—'}</td>
          <td class="text-ink-2">{t.data.envio_nacional ? 'Nacional' : '—'}</td>
          <td class="text-ink-2">{t.data.maneja_preventa ? 'Sí' : '—'}</td>
          <td class="text-ink-2">{t.data.verificacion.estado === 'verificada' ? 'Verificada' : 'Sin verificar'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

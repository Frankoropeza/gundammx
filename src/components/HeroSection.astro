---
import SearchBar from '@components/SearchBar.astro';
interface Props { totalTiendas: number; totalVerificadas: number; totalEstados: number }
const { totalTiendas, totalVerificadas, totalEstados } = Astro.props;
const metricas = [
  { valor: totalTiendas, etiqueta: 'tiendas en el directorio' },
  { valor: totalVerificadas, etiqueta: 'con oferta verificada' },
  { valor: totalEstados, etiqueta: 'estados con tiendas' },
];
---

<section class="border-b border-line">
  <div class="grid-page grid gap-12 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
    <!-- Columna 1: propuesta de valor y buscador -->
    <div class="lg:col-span-7">
      <p class="eyebrow">Directorio independiente · México</p>
      <h1 class="display mt-5 text-5xl md:text-6xl text-balance" data-pagefind-meta="title">
        Gundam en México: tiendas, kits, guías y comunidad.
      </h1>
      <p class="mt-6 max-w-prose text-lg text-ink-2 text-pretty">
        Tiendas verificadas una por una, con fuente y fecha a la vista. Precio de referencia en pesos
        para detectar sobreprecio. Guías de armado, calendario de eventos y talleres.
        Sin afiliación con ninguna marca.
      </p>
      <div class="mt-8"><SearchBar /></div>
      <p class="mt-3 font-mono text-xs text-ink-3">Prueba «Guadalajara», «Master Grade» o «preventa»</p>
    </div>

    <!-- Columna 2: contexto editorial -->
    <div class="space-y-5 text-base leading-relaxed text-ink-2 text-pretty lg:col-span-5 lg:border-l lg:border-line lg:pl-12">
      <p>
        <strong class="font-medium text-ink">GUNDAMMX</strong> reúne en un solo lugar todo lo que necesita
        quien arma <strong class="font-medium text-ink">Gunpla</strong> en México: dónde comprar model kits
        originales de Bandai —Entry Grade, High Grade, Real Grade, Master Grade y Perfect Grade—, qué tiendas
        envían a todo el país, cuáles manejan preventas y cuánto debería costar cada kit en pesos frente al
        precio de lista japonés.
      </p>
      <p>
        Además del directorio de tiendas en Ciudad de México, Guadalajara, Monterrey y el resto de la
        República, publicamos guías para principiantes, comparativas de grados, dónde conseguir pinturas y
        herramientas de modelismo, talleres de armado y pintura, y el calendario de convenciones, concursos
        y eventos Gundam en México. Todo con fuente citada y sin producto falsificado.
      </p>
    </div>

    <!-- Métricas -->
    <dl class="grid grid-cols-3 gap-6 border-t border-line pt-8 lg:col-span-12">
      {metricas.map((m) => (
        <div>
          <dd class="display text-4xl tabular">{m.valor}</dd>
          <dt class="mt-1 text-xs text-ink-3">{m.etiqueta}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>

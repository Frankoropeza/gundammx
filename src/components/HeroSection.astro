---
import SearchBar from '@components/SearchBar.astro';
interface Props { totalTiendas: number; totalVerificadas: number; totalEstados: number }
const { totalTiendas, totalVerificadas, totalEstados } = Astro.props;
const metricas = [
  { valor: totalTiendas, etiqueta: 'tiendas en el directorio' },
  { valor: totalVerificadas, etiqueta: 'con oferta verificada' },
  { valor: totalEstados, etiqueta: 'estados con tiendas' },
];
---

<section class="border-b border-line">
  <div class="grid-page grid gap-10 py-16 md:grid-cols-12 md:py-24 lg:py-28">
    <div class="md:col-span-8">
      <p class="eyebrow">Directorio independiente · México</p>
      <h1 class="display mt-5 text-5xl md:text-6xl text-balance" data-pagefind-meta="title">Dónde comprar Gundam original en México.</h1>
      <p class="mt-6 max-w-prose text-lg text-ink-2 text-pretty">
        Tiendas verificadas una por una, con fuente y fecha a la vista. Precio de referencia en pesos
        para detectar sobreprecio. Sin afiliación con ninguna marca.
      </p>
      <div class="mt-8"><SearchBar /></div>
      <p class="mt-3 font-mono text-xs text-ink-3">Prueba «Guadalajara», «Master Grade» o «preventa»</p>
    </div>

    <dl class="grid grid-cols-3 gap-6 self-end md:col-span-4 md:grid-cols-1 md:border-l md:border-line md:pl-8">
      {metricas.map((m) => (
        <div>
          <dd class="display text-4xl tabular">{m.valor}</dd>
          <dt class="mt-1 text-xs text-ink-3">{m.etiqueta}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>

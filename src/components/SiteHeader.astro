---
import { SITE, NAV, NAV_SECUNDARIA } from '@config/site';
import SearchDialog from '@components/SearchDialog.astro';
const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<div class="franja-gundam" aria-hidden="true"></div>

<div class="border-b border-line bg-surface">
  <div class="grid-page flex h-9 items-center justify-between gap-6 overflow-hidden">
    <p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">
      <span class="text-ink">{SITE.nombreLargo}</span>
      <span aria-hidden="true" class="hidden text-ink-3 sm:inline">·</span>
      <span class="hidden text-ink-3 sm:inline">Archivo independiente del universo Gundam</span>
    </p>
    <nav aria-label="Secciones del directorio" class="hidden shrink lg:block">
      <ul class="flex items-center gap-5">
        {NAV_SECUNDARIA.map((i) => (
          <li><a href={i.href} class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3 transition-colors hover:text-ink">{i.texto}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="grid-page flex h-16 items-center gap-6">
    <a href="/" class="flex shrink-0 items-baseline gap-3" aria-label="GUNDAMMX, inicio">
      <span class="wordmark text-[1.5rem] leading-none sm:text-[1.65rem]">GUNDA<span class="mx">MX</span></span>
      <span class="hidden whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3 xl:inline">{SITE.descriptor}</span>
    </a>

    <nav aria-label="Principal" class="hidden flex-1 lg:block">
      <ul class="flex items-center justify-center gap-6">
        {NAV.map((i) => (
          <li>
            <a href={i.href} aria-current={activo(i.href) ? 'page' : undefined}
              class:list={['whitespace-nowrap text-sm transition-colors hover:text-ink', activo(i.href) ? 'text-ink underline decoration-brand decoration-2 underline-offset-[7px]' : 'text-ink-2']}>{i.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="https://comunidad.gundam.mx/foro/"
        class="btn-primary hidden min-h-9 px-4 sm:inline-flex"
        aria-label="Ir al foro de la comunidad Gundam México"
      >
        <span class="font-mono text-xs uppercase tracking-[0.14em]">Foro</span>
      </a>
      <button type="button" data-abrir-busqueda class="btn-ghost gap-2" aria-label="Abrir búsqueda">
        <span class="font-mono text-xs uppercase tracking-[0.14em]">Buscar</span>
        <kbd class="hidden rounded-sm border border-line px-1.5 font-mono text-[10px] text-ink-3 lg:inline">⌘K</kbd>
      </button>
      <button id="menu-btn" type="button" class="btn-ghost lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
        <span class="font-mono text-xs uppercase tracking-[0.14em]">Menú</span>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="border-t border-line bg-paper lg:hidden" hidden>
    <nav aria-label="Principal móvil" class="grid-page py-2">
      <a
        href="https://comunidad.gundam.mx/foro/"
        class="btn-primary mb-2 mt-2 w-full justify-center"
      >
        <span class="font-mono text-xs uppercase tracking-[0.14em]">Ir al foro de la comunidad</span>
      </a>
      <ul class="divide-y divide-line">
        {NAV.map((i) => <li><a href={i.href} class="block py-3 text-base text-ink transition-colors hover:text-accent">{i.texto}</a></li>)}
        {NAV_SECUNDARIA.map((i) => (
          <li class="lg:hidden"><a href={i.href} class="block py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink-2">{i.texto}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<SearchDialog />

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-movil');
  btn?.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    btn.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    if (menu) menu.hidden = abierto;
  });
</script>

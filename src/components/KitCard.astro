---
import type { CollectionEntry } from 'astro:content';
import { GRADOS } from '@config/site';
import { rangoEstimadoMXN, pesos } from '@lib/precio';
interface Props { kit: CollectionEntry<'kits'> }
const { kit } = Astro.props;
const d = kit.data;
const rango = d.precio_jp_jpy ? rangoEstimadoMXN(d.precio_jp_jpy) : null;
---

<article class="card relative p-5">
  <div class="flex items-center justify-between">
    <span class="tag">{GRADOS[d.grado].etiqueta}</span>
    <span class="font-mono text-xs text-ink-3">{d.escala}</span>
  </div>
  <h3 class="display mt-4 text-xl leading-tight">
    <a href={`/kit/${kit.id}/`} class="after:absolute after:inset-0 after:content-['']">{d.nombre}</a>
  </h3>
  <p class="mt-1 text-xs text-ink-3">{d.serie}</p>
  {rango && (
    <p class="mt-auto pt-5 font-mono text-sm text-ink tabular">
      {pesos(rango.min)} – {pesos(rango.max)}
      <span class="block text-[11px] text-ink-3">estimado en México</span>
    </p>
  )}
</article>

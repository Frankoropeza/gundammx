---
/**
 * Dos pistas explícitas: cronología interna (año ficticio) y orden recomendado para empezar.
 * No se mezclan: son preguntas distintas.
 */
import type { CollectionEntry } from 'astro:content';
interface Props { cronologia: CollectionEntry<'series'>[]; recomendado: CollectionEntry<'series'>[]; compacto?: boolean }
const { cronologia, recomendado, compacto = false } = Astro.props;
---
<section class="grid-page py-16" aria-labelledby="tl-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="class-line">Guía de entrada</p>
      <h2 id="tl-h" class="display mt-3 text-3xl md:text-4xl">¿En qué orden ver Gundam?</h2>
      <p class="mt-3 max-w-prose text-ink-2 text-pretty">
        Son dos preguntas distintas. La cronología interna ordena la ficción por su calendario; el orden recomendado
        ordena por dónde conviene empezar hoy. Un principiante no debería seguir la primera.
      </p>
    </div>
    {compacto && <a href="/cronologia/" class="link text-sm">Cronología completa</a>}
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h3 class="class-line">Pista A · Orden recomendado para empezar</h3>
      <ol class="mt-5 divide-y divide-line border-y border-line">
        {recomendado.map((s, i) => (
          <li class="flex items-baseline gap-5 py-4">
            <span class="folio w-6 shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <a href={`/series/${s.id}/`} class="link-quiet text-base">{s.data.titulo}</a>
              <p class="mt-0.5 font-mono text-xs text-ink-3">{s.data.anio}{s.data.anio_ficcion ? ` · ${s.data.anio_ficcion}` : ''}{s.data.ruta === 'empieza-aqui' ? ' · empieza aquí' : ''}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div>
      <h3 class="class-line">Pista B · Cronología interna del Universal Century</h3>
      <ol class="mt-5 divide-y divide-line border-y border-line">
        {cronologia.map((s) => (
          <li class="flex items-baseline gap-5 py-4">
            <span class="w-20 shrink-0 font-mono text-xs tabular text-ink-2">{s.data.anio_ficcion}</span>
            <div class="min-w-0">
              <a href={`/series/${s.id}/`} class="link-quiet text-base">{s.data.titulo}</a>
              <p class="mt-0.5 font-mono text-xs text-ink-3">{s.data.anio} · {s.data.formato === 'tv' ? 'TV' : s.data.formato === 'ova' ? 'OVA' : s.data.formato === 'pelicula' ? 'Película' : 'Web'}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-ink-3 text-pretty">Solo obras presentes en el archivo. Las líneas alternas (After Colony, Cosmic Era, Anno Domini, Post Disaster, Ad Stella, Correct Century) son independientes y no requieren orden previo.</p>
    </div>
  </div>
</section>

---
/** Selector de tema en tres estados: automático → claro → oscuro. Persiste en localStorage. */
---
<button
  id="tema-btn"
  type="button"
  class="btn-ghost font-mono text-xs uppercase tracking-[0.14em]"
  aria-label="Cambiar tema"
  title="Tema: automático"
  data-estado="auto"
>
  <span aria-hidden="true" data-etiqueta>Auto</span>
</button>

<script>
  const btn = document.getElementById('tema-btn');
  const etiqueta = btn?.querySelector('[data-etiqueta]');
  const ORDEN = ['auto', 'light', 'dark'] as const;
  const NOMBRES: Record<string, string> = { auto: 'Auto', light: 'Claro', dark: 'Oscuro' };

  const aplicar = (estado: string) => {
    if (estado === 'auto') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', estado);
    btn?.setAttribute('data-estado', estado);
    btn?.setAttribute('title', `Tema: ${NOMBRES[estado].toLowerCase()}`);
    if (etiqueta) etiqueta.textContent = NOMBRES[estado];
  };

  let actual = 'auto';
  try { actual = localStorage.getItem('tema') ?? 'auto'; } catch {}
  aplicar(actual);

  btn?.addEventListener('click', () => {
    actual = ORDEN[(ORDEN.indexOf(actual as typeof ORDEN[number]) + 1) % ORDEN.length];
    aplicar(actual);
    try { actual === 'auto' ? localStorage.removeItem('tema') : localStorage.setItem('tema', actual); } catch {}
  });
</script>

---
import { SITE, NAV } from '@config/site';
import AvisoIndependencia from '@components/AvisoIndependencia.astro';
const anio = new Date().getFullYear();
---

<footer class="mt-16 border-t border-base-line bg-base-surface">
  <div class="contenedor py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="font-display text-lg font-bold">
          <span class="text-ink">GUNDAM</span><span class="text-accent">MX</span>
        </p>
        <p class="mt-3 max-w-xs text-sm text-ink-muted">{SITE.descripcion}</p>
      </div>

      <div>
        <h2 class="font-display text-sm uppercase tracking-wider text-ink">Directorio</h2>
        <ul class="mt-4 space-y-2">
          {NAV.map((i) => (
            <li><a href={i.href} class="text-sm text-ink-muted hover:text-accent">{i.texto}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm uppercase tracking-wider text-ink">El proyecto</h2>
        <ul class="mt-4 space-y-2">
          <li><a href="/metodologia/" class="text-sm text-ink-muted hover:text-accent">Cómo verificamos</a></li>
          <li><a href="/alta-de-tienda/" class="text-sm text-ink-muted hover:text-accent">Dar de alta una tienda</a></li>
          <li><a href="/reportar/" class="text-sm text-ink-muted hover:text-accent">Reportar un dato</a></li>
          <li><a href="/aviso-legal/" class="text-sm text-ink-muted hover:text-accent">Aviso legal</a></li>
          <li><span class="text-sm text-ink-faint">{SITE.email}</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-10">
      <AvisoIndependencia compacto />
    </div>

    <p class="mt-6 text-xs text-ink-faint">© {anio} {SITE.nombre} — {SITE.nombreLargo}. {SITE.ciudad}, México.</p>
  </div>
</footer>

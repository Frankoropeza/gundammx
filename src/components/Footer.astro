---
import { SITE, NAV } from '@config/site';
import AvisoIndependencia from '@components/AvisoIndependencia.astro';
const anio = new Date().getFullYear();
---

<footer class="mt-30 border-t border-line">
  <div class="grid-page grid gap-10 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-serif text-3xl text-ink">GUNDAM<span class="text-accent">MX</span></p>
      <p class="mt-4 max-w-sm text-sm text-ink-2 text-pretty">{SITE.descripcion}</p>
    </div>

    <nav aria-label="Secciones" class="md:col-span-3">
      <h2 class="eyebrow">Directorio</h2>
      <ul class="mt-4 space-y-2">
        {NAV.map((i) => <li><a href={i.href} class="link-quiet text-sm">{i.texto}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="El proyecto" class="md:col-span-4">
      <h2 class="eyebrow">El proyecto</h2>
      <ul class="mt-4 space-y-2">
        <li><a href="/metodologia/" class="link-quiet text-sm">Cómo verificamos</a></li>
        <li><a href="/alta-de-tienda/" class="link-quiet text-sm">Dar de alta una tienda</a></li>
        <li><a href="/reportar/" class="link-quiet text-sm">Reportar un dato</a></li>
        <li><a href="/aviso-legal/" class="link-quiet text-sm">Aviso legal</a></li>
        <li><span class="font-mono text-sm text-ink-3">{SITE.email}</span></li>
      </ul>
    </nav>

    <div class="md:col-span-12"><AvisoIndependencia compacto /></div>

    <p class="font-mono text-xs text-ink-3 md:col-span-12">
      © {anio} {SITE.nombre} · {SITE.nombreLargo} · {SITE.ciudad}, México
    </p>
  </div>
</footer>

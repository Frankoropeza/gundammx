---
/** Imagen propia/licenciada si existe; si no, marco pendiente. Dimensiones fijas: cero CLS. */
import { Image } from 'astro:assets';
import ImagenPendiente from '@components/ImagenPendiente.astro';
interface Props {
  src?: ImageMetadata; alt?: string; codigo: string; ancho?: number; alto?: number;
  prioridad?: boolean; class?: string; ratio?: string;
}
const { src, alt = '', codigo, ancho = 1600, alto = 1000, prioridad = false, class: cls = '', ratio = 'aspect-[16/10]' } = Astro.props;
---
{src
  ? <Image src={src} alt={alt} width={ancho} height={alto} class:list={['w-full object-cover', ratio, cls]} loading={prioridad ? 'eager' : 'lazy'} fetchpriority={prioridad ? 'high' : undefined} decoding="async" />
  : <ImagenPendiente codigo={codigo} ratio={ratio} class={cls} />}

---
import { fechaCorta } from '@lib/precio';
interface Props {
  estado: 'verificada' | 'reportada' | 'sin_verificar' | 'cerrada';
  fecha?: string;
  conEnlace?: boolean;
}
const { estado, fecha, conEnlace = true } = Astro.props;
const mapa = {
  verificada:    { texto: 'Verificada',    clase: 'tag-accent' },
  sin_verificar: { texto: 'Sin verificar', clase: 'tag-signal' },
  reportada:     { texto: 'Reportada',     clase: 'tag-alert' },
  cerrada:       { texto: 'Cerrada',       clase: 'tag-alert line-through' },
} as const;
const s = mapa[estado];
---

<span class:list={[s.clase, 'gap-2']}>
  <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>
  <span>{s.texto}</span>
  {fecha && <span class="opacity-70">{fechaCorta(fecha)}</span>}
  {conEnlace && <a href="/metodologia/" class="underline decoration-dotted underline-offset-2" aria-label="Cómo verificamos">?</a>}
</span>

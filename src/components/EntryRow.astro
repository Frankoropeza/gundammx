---
interface Props {
  items: { titulo: string; texto: string; meta: string; href: string }[];
}
const { items } = Astro.props;
---
<nav class="border-b border-line" aria-label="Rutas de entrada al archivo">
  <ol class="grid-page grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
    {items.map((i, n) => (
      <li class="group relative flex flex-col border-l border-line px-6 py-7 transition-colors hover:bg-surface">
        <p class="folio">{String(n + 1).padStart(2, '0')}</p>
        <h2 class="display mt-5 text-xl leading-tight">
          <a href={i.href} class="after:absolute after:inset-0 after:content-['']">{i.titulo}</a>
        </h2>
        <p class="mt-2 flex-1 text-sm text-ink-2 text-pretty">{i.texto}</p>
        <p class="mt-6 pt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">{i.meta}</p>
      </li>
    ))}
  </ol>
</nav>

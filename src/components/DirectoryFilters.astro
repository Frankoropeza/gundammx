---
/**
 * Filtros progresivos.
 * - Sin JS: los enlaces de ciudad/categoría (fuera de este componente) siguen funcionando
 *   y el formulario hace GET inofensivo a la misma página.
 * - Con JS: filtra las tarjetas en el DOM por data-atributos, sin crear URLs nuevas
 *   (las únicas facetas indexables son las curadas). Sincroniza con ?params para poder compartir.
 */
import { GRADOS, type GradoId } from '@config/site';
import { nombreEstado } from '@lib/estados';

interface Props {
  ciudades: { slug: string; nombre: string }[];
  estados: string[];
  mostrarCiudad?: boolean;
  mostrarEstado?: boolean;
}
const { ciudades, estados, mostrarCiudad = true, mostrarEstado = true } = Astro.props;

const categorias = [
  ['especialista', 'Especialista en Gunpla'],
  ['coleccionables', 'Coleccionables'],
  ['modelismo', 'Modelismo'],
  ['oficial', 'Canal oficial'],
] as const;
const grados = (Object.keys(GRADOS) as GradoId[]).sort((a, b) => GRADOS[a].orden - GRADOS[b].orden);
---

<details class="group border-y border-line" id="filtros" open data-pagefind-ignore>
  <summary class="flex min-h-12 items-center justify-between px-5 text-sm font-medium">
    <span>Filtrar</span>
    <span class="font-mono text-xs text-ink-3" id="filtros-conteo" aria-live="polite"></span>
  </summary>

  <form id="filtros-form" method="get" class="grid gap-4 border-t border-line p-5 sm:grid-cols-2 lg:grid-cols-6">
    {mostrarCiudad && (
      <div class="lg:col-span-2">
        <label for="f-ciudad" class="eyebrow block">Ciudad</label>
        <select id="f-ciudad" name="ciudad" class="mt-2 h-11 w-full border border-line bg-white px-3 text-sm">
          <option value="">Todas</option>
          {ciudades.map((c) => <option value={c.nombre}>{c.nombre}</option>)}
        </select>
      </div>
    )}
    {mostrarEstado && (
      <div class="lg:col-span-2">
        <label for="f-estado" class="eyebrow block">Estado</label>
        <select id="f-estado" name="estado" class="mt-2 h-11 w-full border border-line bg-white px-3 text-sm">
          <option value="">Todos</option>
          {estados.map((e) => <option value={e}>{nombreEstado(e)}</option>)}
        </select>
      </div>
    )}
    <div class="lg:col-span-1">
      <label for="f-categoria" class="eyebrow block">Tipo</label>
      <select id="f-categoria" name="categoria" class="mt-2 h-11 w-full border border-line bg-white px-3 text-sm">
        <option value="">Todos</option>
        {categorias.map(([v, t]) => <option value={v}>{t}</option>)}
      </select>
    </div>
    <div class="lg:col-span-1">
      <label for="f-grado" class="eyebrow block">Grado</label>
      <select id="f-grado" name="grado" class="mt-2 h-11 w-full border border-line bg-white px-3 text-sm">
        <option value="">Todos</option>
        {grados.map((g) => <option value={g}>{GRADOS[g].etiqueta} — {GRADOS[g].nombre}</option>)}
      </select>
    </div>

    <fieldset class="flex flex-wrap gap-x-6 gap-y-3 sm:col-span-2 lg:col-span-6">
      <legend class="eyebrow mb-2 w-full">Condiciones</legend>
      <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="envio" value="1" class="h-4 w-4 accent-black" /> Envío a todo México</label>
      <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="preventa" value="1" class="h-4 w-4 accent-black" /> Maneja preventas</label>
      <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="verificada" value="1" class="h-4 w-4 accent-black" /> Solo verificadas</label>
    </fieldset>

    <div class="flex gap-2 sm:col-span-2 lg:col-span-6">
      <button type="submit" class="btn-primary">Aplicar</button>
      <button type="reset" class="btn-secondary" id="filtros-reset">Limpiar</button>
    </div>
  </form>
</details>

<div id="filtros-vacio" class="mt-6" hidden>
  <div class="border border-dashed border-line px-6 py-14 text-center">
    <p class="display text-2xl">Ninguna tienda coincide</p>
    <p class="mx-auto mt-3 max-w-md text-sm text-ink-2">Quita alguna condición o revisa las tiendas con envío a todo México.</p>
    <a href="/tiendas/en-linea/" class="btn-secondary mt-6">Ver tiendas con envío nacional</a>
  </div>
</div>

<script>
  const form = document.getElementById('filtros-form') as HTMLFormElement | null;
  const conteo = document.getElementById('filtros-conteo');
  const vacio = document.getElementById('filtros-vacio');
  const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('[data-categoria]'));

  if (form && tarjetas.length) {
    const leer = () => {
      const f = new FormData(form);
      return {
        ciudad: String(f.get('ciudad') ?? ''),
        estado: String(f.get('estado') ?? ''),
        categoria: String(f.get('categoria') ?? ''),
        grado: String(f.get('grado') ?? ''),
        envio: f.get('envio') === '1',
        preventa: f.get('preventa') === '1',
        verificada: f.get('verificada') === '1',
      };
    };

    const aplicar = () => {
      const q = leer();
      let visibles = 0;
      for (const t of tarjetas) {
        const ciudades = (t.dataset.ciudades ?? '').split('|');
        const grados = (t.dataset.grados ?? '').split('|');
        const ok =
          (!q.ciudad || ciudades.includes(q.ciudad)) &&
          (!q.estado || t.dataset.estado === q.estado) &&
          (!q.categoria || t.dataset.categoria === q.categoria) &&
          (!q.grado || grados.includes(q.grado)) &&
          (!q.envio || t.dataset.envio === '1') &&
          (!q.preventa || t.dataset.preventa === '1') &&
          (!q.verificada || t.dataset.verificada === '1');
        t.hidden = !ok;
        if (ok) visibles++;
      }
      if (conteo) conteo.textContent = `${visibles} de ${tarjetas.length}`;
      if (vacio) vacio.hidden = visibles > 0;

      // Estado compartible sin recargar y sin crear rutas
      const params = new URLSearchParams();
      Object.entries(q).forEach(([k, v]) => { if (v && v !== '') params.set(k, v === true ? '1' : String(v)); });
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    // Estado inicial desde la URL (permite que el GET sin JS también funcione al recargar)
    const inicial = new URLSearchParams(location.search);
    for (const el of form.elements) {
      if (!(el instanceof HTMLInputElement || el instanceof HTMLSelectElement) || !el.name) continue;
      const v = inicial.get(el.name);
      if (v === null) continue;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = v === '1';
      else el.value = v;
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); aplicar(); });
    form.addEventListener('change', aplicar);
    form.addEventListener('reset', () => setTimeout(aplicar, 0));
    aplicar();
  }
</script>

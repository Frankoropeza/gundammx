---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import InvitacionForo from '@components/InvitacionForo.astro';
import type { CategoriaForo } from '@lib/foro';
import { fechaLarga } from '@lib/precio';
interface Props {
  titulo: string; descripcion: string; fecha?: Date; actualizada?: string;
  migas: { nombre: string; href: string }[];
  fuente?: { nombre: string; url: string };
  schemas?: unknown[];
  eyebrow?: string;
  categoriaForo?: CategoriaForo;
}
const { titulo, descripcion, fecha, actualizada, migas, fuente, schemas = [], eyebrow, categoriaForo = 'general' } = Astro.props;
---

<BaseLayout titulo={titulo} descripcion={descripcion} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page grid gap-10 py-10 md:grid-cols-12">
    <header class="md:col-span-10 md:col-start-2">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="display mt-3 text-4xl md:text-5xl text-balance">{titulo}</h1>
      <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{descripcion}</p>
      <p class="mt-5 font-mono text-xs text-ink-3">
        {fecha && <>Publicado el {fechaLarga(fecha)}</>}
        {actualizada && <> · Actualizado el {fechaLarga(actualizada)}</>}
      </p>
    </header>
    <div class="prose-ed md:col-span-7 md:col-start-2">
      <slot />
      <InvitacionForo categoria={categoriaForo} class="not-prose mt-10" />
    </div>
    <aside class="md:col-span-3 md:col-start-9">
      <slot name="lateral" />
      <InvitacionForo categoria={categoriaForo} variante="tarjeta" class="mt-8 hidden lg:block" />
    </aside>
    {fuente && (
      <footer class="border-t border-line pt-5 text-sm md:col-span-7 md:col-start-2">
        <p class="text-ink-2"><span class="text-ink-3">Fuente:</span> <a href={fuente.url} class="link" rel="nofollow noopener" target="_blank">{fuente.nombre}</a></p>
        <p class="mt-2 text-xs text-ink-3">GUNDAMMX es un medio independiente. Redactamos nuestras notas y enlazamos siempre a la fuente original.</p>
      </footer>
    )}
  </article>
</BaseLayout>

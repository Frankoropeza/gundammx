---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fechaLarga } from '@lib/precio';

interface Props {
  titulo: string;
  descripcion: string;
  fecha?: Date;
  actualizada?: string;
  migas: { nombre: string; href: string }[];
  fuente?: { nombre: string; url: string };
  schemas?: unknown[];
}

const { titulo, descripcion, fecha, actualizada, migas, fuente, schemas = [] } = Astro.props;
---

<BaseLayout titulo={titulo} descripcion={descripcion} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />

  <article class="contenedor max-w-3xl py-8">
    <header>
      <h1 class="font-display text-3xl font-bold leading-tight md:text-4xl">{titulo}</h1>
      <p class="mt-4 text-lg text-ink-muted">{descripcion}</p>
      <p class="mt-4 font-mono text-xs text-ink-faint">
        {fecha && <>Publicado el {fechaLarga(fecha)}</>}
        {actualizada && <> · Actualizado el {fechaLarga(actualizada)}</>}
      </p>
    </header>

    <div class="prose-invertida mt-10"><slot /></div>

    {fuente && (
      <footer class="mt-12 rounded-lg border border-base-line bg-base-alt/40 p-4 text-sm">
        <p class="text-ink-muted">
          <span class="text-ink-faint">Fuente:</span>{' '}
          <a href={fuente.url} class="enlace" rel="nofollow noopener" target="_blank">{fuente.nombre}</a>
        </p>
        <p class="mt-2 text-xs text-ink-faint">
          GUNDAMMX es un medio independiente. Redactamos nuestras notas y enlazamos siempre a la fuente original.
        </p>
      </footer>
    )}
  </article>
</BaseLayout>

<style is:global>
  .prose-invertida { @apply text-ink-muted leading-relaxed; }
  .prose-invertida h2 { @apply mt-10 font-display text-2xl font-semibold text-ink; }
  .prose-invertida h3 { @apply mt-8 font-display text-lg font-semibold text-ink; }
  .prose-invertida p { @apply mt-4; }
  .prose-invertida ul { @apply mt-4 list-disc space-y-2 pl-6; }
  .prose-invertida ol { @apply mt-4 list-decimal space-y-2 pl-6; }
  .prose-invertida a { @apply text-accent underline-offset-4 hover:underline; }
  .prose-invertida strong { @apply text-ink; }
  .prose-invertida table { @apply mt-6 w-full border-collapse text-sm; }
  .prose-invertida th { @apply border-b border-base-line py-2 pr-4 text-left text-xs uppercase tracking-wide text-ink-faint; }
  .prose-invertida td { @apply border-b border-base-line/60 py-2 pr-4 align-top; }
  .prose-invertida blockquote { @apply mt-6 border-l-2 border-accent/40 pl-4 italic; }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import KitCard from '@components/KitCard.astro';
import { getCollection } from 'astro:content';
import { GRADOS, type GradoId, FACTOR_MX } from '@config/site';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

const kits = (await getCollection('kits'))
  .sort((a, b) => GRADOS[a.data.grado].orden - GRADOS[b.data.grado].orden);

const conKits = (Object.keys(GRADOS) as GradoId[])
  .filter((g) => kits.some((k) => k.data.grado === g));

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Kits', href: '/kits/' }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, 'Kits de Gunpla con precio de referencia en México',
    kits.map((k) => ({ nombre: k.data.nombre, href: `/kit/${k.id}/` }))),
];
---

<BaseLayout
  titulo="Kits Gunpla México | Precios de referencia"
  descripcion="Cuánto cuesta un Gunpla en México, kit por kit: precio de lista japonés, rango esperado en pesos y precios observados en tiendas Gundam mexicanas, con su fecha."
  schemas={schemas}
>
  <Breadcrumbs items={migas} />

  <div class="grid-page py-8">
    <h1 class="display text-3xl md:text-4xl">Kits y precios de referencia</h1>
    <p class="mt-4 max-w-3xl text-ink-2">
      Para cada kit publicamos el precio de lista en Japón y el rango que debería costar en México,
      calculado con el factor de {FACTOR_MX}× que medimos en el canal oficial. Sirve para una sola cosa:
      saber si el precio que te están pidiendo es normal o es sobreprecio.
    </p>

    <nav class="mt-8 flex flex-wrap gap-2">
      {conKits.map((g) => (
        <a href={`/kits/${g}/`} class="tag hover:border-accent hover:text-accent">
          {GRADOS[g].etiqueta} <span class="ml-1 text-ink-3">{GRADOS[g].nombre}</span>
        </a>
      ))}
    </nav>

    <div class="mt-8 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-6">
      {kits.map((k) => <KitCard kit={k} />)}
    </div>
  </div>
</BaseLayout>

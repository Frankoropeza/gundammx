---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import KitCard from '@components/KitCard.astro';
import { getCollection } from 'astro:content';
import { GRADOS, type GradoId } from '@config/site';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const [kits, grados] = await Promise.all([getCollection('kits'), getCollection('gunpla')]);
  return (Object.keys(GRADOS) as GradoId[]).map((g) => {
    const ficha = grados.find((x) => x.data.etiqueta === GRADOS[g].etiqueta);
    return {
      params: { grado: g },
      props: {
        kits: kits.filter((k) => k.data.grado === g),
        grado: g,
        contexto: ficha ? { resumen: ficha.data.resumen, paraQuien: ficha.data.para_quien, dificultad: ficha.data.dificultad, anio: ficha.data.anio_lanzamiento, href: `/gunpla/${ficha.id}/` } : null,
      },
    };
  });
};

interface Props {
  kits: CollectionEntry<'kits'>[];
  grado: GradoId;
  contexto: { resumen: string; paraQuien: string; dificultad: string; anio: number; href: string } | null;
}

const { kits, grado, contexto } = Astro.props;
const info = GRADOS[grado];

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Kits', href: '/kits/' },
  { nombre: info.etiqueta, href: `/kits/${grado}/` },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, `Kits ${info.etiqueta}`, kits.map((k) => ({
    nombre: k.data.nombre, href: `/kit/${k.id}/`,
  }))),
];
---

<BaseLayout
  titulo={`Kits ${info.etiqueta} | Gunpla ${info.nombre} en México`}
  descripcion={`Kits Gunpla de grado ${info.nombre} (${info.escala}): qué incluye el grado, precio de referencia en pesos y disponibilidad en tiendas Gundam de México.`}
  noindex={kits.length === 0}
  schemas={schemas}
>
  <Breadcrumbs items={migas} />

  <div class="grid-page py-8">
    <h1 class="display text-3xl md:text-4xl">{info.nombre} <span class="text-ink-3">({info.etiqueta})</span></h1>
    <p class="mt-3 font-mono text-sm text-ink-2">Escala {info.escala}</p>

    {contexto && (
      <div class="mt-8 grid gap-8 border-t border-line pt-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="display text-2xl">Qué es el grado {info.nombre}</h2>
          <p class="mt-4 max-w-prose text-ink-2 text-pretty">{contexto.resumen}</p>
          <p class="mt-4 max-w-prose text-ink-2 text-pretty">{contexto.paraQuien}</p>
          <p class="mt-6"><a href={contexto.href} class="link text-sm">Guía completa del grado {info.nombre}</a></p>
        </div>
        <dl class="grid grid-cols-2 gap-x-8 gap-y-6 lg:col-span-5 lg:grid-cols-2">
          <div><dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Escala</dt><dd class="mt-1 text-ink">{info.escala}</dd></div>
          <div><dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Dificultad</dt><dd class="mt-1 text-ink">{contexto.dificultad}</dd></div>
          <div><dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Desde</dt><dd class="mt-1 text-ink">{contexto.anio}</dd></div>
          <div><dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Kits en el archivo</dt><dd class="mt-1 text-ink">{kits.length}</dd></div>
        </dl>
      </div>
    )}

    {kits.length === 0 ? (
      <p class="mt-6 max-w-2xl text-ink-2">
        Todavía no registramos kits de este grado con precio observado en México.
        Estamos poblando el catálogo con los kits que sí circulan en tiendas mexicanas.
      </p>
    ) : (
      <>
      <h2 class="display mt-12 text-2xl md:text-3xl">{`Kits ${info.etiqueta} con precio de referencia`}</h2>
      <div class="mt-6 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-6">
        {kits.map((k) => <KitCard kit={k} />)}
      </div>
      </>
    )}
  </div>
</BaseLayout>

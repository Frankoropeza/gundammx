---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
import RelatedContent from '@components/RelatedContent.astro';
import { entradasPorIds, nombreUniverso, FORMATO } from '@lib/archivo';
import { fechaLarga } from '@lib/precio';
import { schemaFicha, schemaMigaDePan } from '@lib/seo';

export const getStaticPaths = (async () => {
  const pilotos = await getCollection('pilots');
  return Promise.all(pilotos.map(async (p) => ({
    params: { id: p.id },
    props: {
      piloto: p,
      series: await entradasPorIds('series', p.data.series),
      ms: await entradasPorIds('mobile-suits', p.data.mobile_suits),
      facciones: await entradasPorIds('factions', p.data.facciones),
    },
  })));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { piloto, series, ms, facciones } = Astro.props;
const d = piloto.data;
const { Content } = await render(piloto);
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Personajes', href: '/personajes/' }, { nombre: d.nombre, href: `/personajes/${piloto.id}/` }];
const schemas = [schemaMigaDePan(base, migas), schemaFicha(base, { nombre: d.nombre, descripcion: d.resumen, fecha: d.actualizado })];
---
<BaseLayout noindex={d.estado_editorial === 'borrador'} titulo={d.seo?.titulo ?? `${d.nombre}: quién es, serie y mobile suits`} descripcion={d.seo?.descripcion ?? d.resumen} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page py-10">
    <header class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="archive-code">{d.codigo}</p>
        <p class="class-line mt-4">{d.rol} · {nombreUniverso(d.universo)}</p>
        <h1 class="display mt-4 text-4xl md:text-5xl">{d.nombre}</h1>
        {d.alias.length > 0 && <p class="mt-2 font-mono text-sm text-ink-3">También: {d.alias.join(' · ')}</p>}
        <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
        <MetadataRow class="mt-8" items={[
          { etiqueta: 'Serie de origen', valor: series[0]?.data.titulo ?? '', href: series[0] ? `/series/${series[0].id}/` : undefined },
          { etiqueta: 'Facción', valor: facciones.map((f) => f.data.nombre).join(', '), href: facciones[0] ? `/facciones/${facciones[0].id}/` : undefined },
          { etiqueta: 'Mobile suits', valor: ms.map((m) => `${m.data.designacion} ${m.data.nombre}`).join(', ') },
        ]} />
      </div>
      <div class="lg:col-span-5"><Figura src={d.imagen} alt={d.imagen_alt} codigo={d.codigo} prioridad ratio="aspect-[4/5]" /></div>
    </header>
    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="prose-ed lg:col-span-7"><Content /></div>
      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
        <RelatedContent titulo="Aparece en" items={series.map((s) => ({ eyebrow: `${s.data.anio} · ${FORMATO[s.data.formato]}`, titulo: s.data.titulo, href: `/series/${s.id}/` }))} />
        <RelatedContent titulo="Sus máquinas" items={ms.map((m) => ({ codigo: m.data.designacion, eyebrow: 'Mobile suit', titulo: m.data.nombre, href: `/mobile-suits/${m.id}/` }))} />
        <section class="border-t border-line pt-6"><h2 class="class-line">Fuentes</h2><ul class="mt-3 space-y-1">{d.fuentes.map((f) => <li class="truncate text-sm"><a href={f} class="link" rel="nofollow noopener" target="_blank">{f}</a></li>)}</ul><p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Actualizado {fechaLarga(d.actualizado)}</p></section>
      </aside>
    </div>
  </article>
</BaseLayout>

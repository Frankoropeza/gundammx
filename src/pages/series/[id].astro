---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
import RelatedContent from '@components/RelatedContent.astro';
import InvitacionForo from '@components/InvitacionForo.astro';
import { entradasPorIds, FORMATO, nombreUniverso } from '@lib/archivo';
import { fechaLarga } from '@lib/precio';
import { schemaSerie, schemaMigaDePan, descripcionFicha } from '@lib/seo';

export const getStaticPaths = (async () => {
  const series = await getCollection('series');
  return Promise.all(series.map(async (s) => ({
    params: { id: s.id },
    props: {
      serie: s,
      ms: await entradasPorIds('mobile-suits', s.data.mobile_suits),
      pilotos: await entradasPorIds('pilots', s.data.pilotos),
      facciones: await entradasPorIds('factions', s.data.facciones),
      universo: await getCollection('universes').then((u) => u.find((x) => x.data.abreviatura === s.data.universo)),
      vecinas: series.filter((o) => o.id !== s.id && o.data.universo === s.data.universo).slice(0, 3),
    },
  })));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { serie, ms, pilotos, facciones, universo, vecinas } = Astro.props;
const d = serie.data;
const { Content } = await render(serie);
const rutaTexto: Record<string, string> = { 'empieza-aqui': 'Empieza aquí', profundiza: 'Profundiza en el UC', alternativa: 'Alternativa independiente' };
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Series', href: '/series/' }, { nombre: d.titulo, href: `/series/${serie.id}/` }];
const schemas = [schemaMigaDePan(base, migas), schemaSerie(base, { titulo: d.titulo, resumen: d.resumen, anio: d.anio, episodios: d.episodios, formato: d.formato, direccion: d.direccion, estudio: d.estudio, fechaInicio: d.fecha_inicio, fechaFin: d.fecha_fin })];
---
<BaseLayout noindex={d.estado_editorial === 'borrador'} titulo={d.seo?.titulo ?? (d.titulo.length > 38 ? d.titulo : d.titulo.length > 26 ? `${d.titulo} | Serie ${d.anio}` : `${d.titulo} | Serie de Gundam (${d.anio})`)} descripcion={d.seo?.descripcion ?? descripcionFicha(d.resumen, 'Ficha de la serie en Gundam México.')} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page py-10">
    <header class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="archive-code">{d.codigo}</p>
        <p class="class-line mt-4">{FORMATO[d.formato]} · {d.anio} · {nombreUniverso(d.universo)}</p>
        <h1 class="display mt-4 text-4xl md:text-5xl text-balance">{d.titulo}</h1>
        {d.titulo_original && <p class="mt-2 font-mono text-sm text-ink-3">{d.titulo_original}</p>}
        <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
        <p class="mt-4 border-l-2 border-accent pl-4 text-sm text-ink"><span class="text-ink-3">Por qué importa · </span>{d.relevancia}</p>
      </div>
      <div class="lg:col-span-6"><Figura src={d.imagen} alt={d.imagen_alt} credito={d.imagen_credito} codigo={d.codigo} prioridad ratio="aspect-[16/10]" /></div>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <MetadataRow items={[
          { etiqueta: 'Universo', valor: nombreUniverso(d.universo), href: universo ? `/universos/${universo.id}/` : undefined },
          { etiqueta: 'Año en la ficción', valor: d.anio_ficcion ?? '' },
          { etiqueta: 'Emisión', valor: d.fecha_inicio ? `${fechaLarga(d.fecha_inicio)}${d.fecha_fin ? ` – ${fechaLarga(d.fecha_fin)}` : ''}` : String(d.anio) },
          { etiqueta: 'Episodios', valor: d.episodios ? String(d.episodios) : '' },
          { etiqueta: 'Estudio', valor: d.estudio },
          { etiqueta: 'Dirección', valor: d.direccion.join(', ') },
          { etiqueta: 'Ruta', valor: d.ruta ? rutaTexto[d.ruta] : '' },
        ]} />
        <div class="prose-ed mt-10"><Content /></div>
        <section class="mt-10 border-t border-line pt-6">
          <h2 class="class-line">Dónde verla en México</h2>
          {d.disponibilidad_mx.length > 0 ? (
            <ul class="mt-3 space-y-1 text-sm text-ink-2">{d.disponibilidad_mx.map((x) => <li>{x}</li>)}</ul>
          ) : (
            <p class="mt-3 text-sm text-ink-3">Sin disponibilidad verificada en México a la fecha de esta ficha. Los catálogos cambian varias veces al año.</p>
          )}
          <p class="mt-3 text-sm text-ink-2">La tabla completa por serie y el método para comprobarlo en dos minutos están en <a href="/articulos/donde-ver-gundam-en-mexico/" class="link">dónde ver Gundam en México</a>.</p>
        </section>
        <section class="mt-10 border-t border-line pt-6" data-pagefind-ignore>
          <h2 class="class-line">Fuentes</h2>
          <ul class="mt-3 space-y-1">{d.fuentes.map((f) => <li class="truncate text-sm"><a href={f} class="link" rel="nofollow noopener" target="_blank">{f}</a></li>)}</ul>
          <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Estado editorial: {d.estado_editorial} · actualizado {fechaLarga(d.actualizado)}</p>
        </section>
        <InvitacionForo categoria="series-y-universo" class="mt-10" />
      </div>
      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
        <RelatedContent titulo="Mobile suits" items={ms.map((m) => ({ codigo: m.data.designacion, eyebrow: 'Ficha técnica', titulo: m.data.nombre, href: `/mobile-suits/${m.id}/` }))} />
        <RelatedContent titulo="Personajes" items={pilotos.map((p) => ({ eyebrow: p.data.rol, titulo: p.data.nombre, href: `/personajes/${p.id}/` }))} />
        <RelatedContent titulo="Facciones" items={facciones.map((f) => ({ eyebrow: f.data.tipo, titulo: f.data.nombre, href: `/facciones/${f.id}/` }))} />
      </aside>
    </div>
    <div class="mt-16" data-pagefind-ignore>
      <RelatedContent titulo={`Más en ${nombreUniverso(d.universo)}`} items={vecinas.map((v) => ({ eyebrow: `${v.data.anio} · ${FORMATO[v.data.formato]}`, titulo: v.data.titulo, href: `/series/${v.id}/`, texto: v.data.relevancia }))} />
    </div>
  </article>
</BaseLayout>

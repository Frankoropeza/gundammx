---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import TarjetaTienda from '@components/TarjetaTienda.astro';
import TarjetaNoticia from '@components/TarjetaNoticia.astro';
import { getCollection } from 'astro:content';
import { tiendasActivas, tiendasVerificadas, ciudadesConPagina, indexable } from '@lib/directorio';
import { SITE } from '@config/site';

const tiendas = await tiendasActivas();
const verificadas = await tiendasVerificadas();
const ciudades = (await ciudadesConPagina()).filter((c) => indexable(c.total));

const noticias = (await getCollection('noticias', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const guias = (await getCollection('guias', ({ data }) => !data.borrador))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);
---

<BaseLayout titulo={SITE.nombre} descripcion={SITE.descripcion}>
  <HeroSection
    totalTiendas={tiendas.length}
    totalVerificadas={verificadas.length}
    totalCiudades={ciudades.length}
  />

  <section class="contenedor py-14">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-bold">Busca por ciudad</h2>
      <a href="/tiendas/" class="enlace text-sm">Ver todo el directorio</a>
    </div>
    <ul class="mt-6 flex flex-wrap gap-2">
      {ciudades.map((c) => (
        <li>
          <a href={`/tiendas/ciudad/${c.slug}/`} class="chip hover:border-accent hover:text-accent">
            {c.nombre} <span class="ml-1 text-ink-faint">{c.total}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="contenedor pb-14">
    <h2 class="font-display text-2xl font-bold">Tiendas con oferta verificada</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">
      Cada ficha declara con qué fuente y en qué fecha comprobamos que vende Gunpla.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {verificadas.slice(0, 6).map((t) => <TarjetaTienda tienda={t} />)}
    </div>
  </section>

  {guias.length > 0 && (
    <section class="contenedor pb-14">
      <h2 class="font-display text-2xl font-bold">Guías para empezar</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {guias.map((g) => (
          <li class="tarjeta">
            <a href={`/guias/${g.id}/`} class="font-medium hover:text-accent">{g.data.titulo}</a>
            <p class="mt-2 text-sm text-ink-muted">{g.data.descripcion}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {noticias.length > 0 && (
    <section class="contenedor pb-16">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-2xl font-bold">Noticias</h2>
        <a href="/noticias/" class="enlace text-sm">Todas las noticias</a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {noticias.map((n) => <TarjetaNoticia nota={n} />)}
      </div>
    </section>
  )}
</BaseLayout>

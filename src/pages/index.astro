---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/EditorialHero.astro';
import UniverseNavigator from '@components/UniverseNavigator.astro';
import SeriesRail from '@components/SeriesRail.astro';
import MobileSuitCard from '@components/MobileSuitCard.astro';
import TimelineGuide from '@components/TimelineGuide.astro';
import ArchiveCard from '@components/ArchiveCard.astro';
import GunplaBlock from '@components/GunplaBlock.astro';
import EntryRow from '@components/EntryRow.astro';
import UniverseTimeline from '@components/UniverseTimeline.astro';
import NewsletterCTA from '@components/NewsletterCTA.astro';
import FAQ from '@components/FAQ.astro';
import { universosConContenido, seriesOrdenRecomendado, seriesCronologiaUC, seriesPorRuta, nombres, publicado } from '@lib/archivo';
import { tiendasActivas, tiendasVerificadas, estadosConTiendas } from '@lib/directorio';
import { SITE } from '@config/site';
import { schemaFAQ } from '@lib/seo';
import { fechaCorta } from '@lib/precio';

const universos = await universosConContenido();
const recomendado = (await seriesOrdenRecomendado()).slice(0, 8);
const cronologia = await seriesCronologiaUC();
const empiezaAqui = await seriesPorRuta('empieza-aqui');
const profundiza = await seriesPorRuta('profundiza');
const alternativas = await seriesPorRuta('alternativa');

const ms = (await getCollection('mobile-suits', publicado)).sort((a, b) => a.data.codigo.localeCompare(b.data.codigo));
const destacadosMS = ['rx-78-2-gundam', 'ms-06-zaku-ii', 'xxxg-01w-wing-gundam', 'rx-0-unicorn-gundam', 'asw-g-08-gundam-barbatos', 'xvx-016-gundam-aerial']
  .map((id) => ms.find((m) => m.id === id)).filter(Boolean) as typeof ms;
const n = await nombres();

const articulos = (await getCollection('articles', ({ data }) => !data.borrador)).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const destacado = articulos.find((a) => a.data.destacado) ?? articulos[0];
const archivo = articulos.filter((a) => a.id !== destacado?.id).slice(0, 5);

const grados = (await getCollection('gunpla', publicado)).sort((a, b) => a.data.orden - b.data.orden);
const guias = (await getCollection('guides', ({ data }) => !data.borrador)).sort((a, b) => a.data.orden - b.data.orden).slice(0, 4);
const tiendas = await tiendasActivas();
const verificadas = await tiendasVerificadas();
const estados = await estadosConTiendas();
const totalEstados = estados.size;
const pilotos = await getCollection('pilots', publicado);
const facciones = await getCollection('factions', publicado);
const todasSeries = await getCollection('series', publicado);

const aniosSerie = todasSeries.map((x) => x.data.anio);
const primerAnio = Math.min(...aniosSerie);
const ultimoAnio = Math.max(...aniosSerie);

const filasLinea = universos.map((u) => ({
  universo: u.data.abreviatura,
  nombre: u.data.nombre,
  href: `/universos/${u.id}/`,
  obras: todasSeries
    .filter((x) => x.data.universo === u.data.abreviatura)
    .sort((a, b) => a.data.anio - b.data.anio)
    .map((x) => ({ titulo: x.data.titulo, anio: x.data.anio, href: `/series/${x.id}/` })),
}));

const faq = [
  {
    pregunta: '¿En qué orden hay que ver Gundam?',
    respuesta: `No hay un orden único: las ${universos.length} líneas temporales de Gundam son independientes y cada una se puede ver por separado. Para empezar de cero conviene elegir una serie de entrada —Mobile Suit Gundam si quieres el origen, Gundam Wing, SEED o The Witch from Mercury si prefieres una historia cerrada— y solo después decidir si sigues el Universal Century en orden.`,
  },
  {
    pregunta: '¿Dónde se puede ver Gundam en México?',
    respuesta: 'El catálogo está repartido entre Crunchyroll, Netflix, Prime Video y Disney+, además del canal oficial de Gundam en YouTube, que publica series completas de forma gratuita y rotativa. En televisión abierta, Azteca 7 transmite Mobile Suit Gundam SEED con doblaje latino desde el 28 de noviembre de 2025.',
  },
  {
    pregunta: '¿Qué es el Gunpla?',
    respuesta: `Gunpla es la contracción de "Gundam plastic model": los kits armables de plástico que Bandai fabrica desde 1980. Se arman a presión, sin pegamento, y se clasifican por grados —Entry Grade, High Grade, Real Grade, Master Grade y Perfect Grade— que cambian en escala, número de piezas y detalle.`,
  },
  {
    pregunta: '¿Cuál es el mejor Gunpla para empezar?',
    respuesta: 'Un Entry Grade o un High Grade en escala 1/144: son los más baratos, se arman en un par de horas y no necesitan pegamento ni pintura. El Master Grade y el Perfect Grade tienen mucho más detalle, pero también más piezas, más tiempo y un precio bastante mayor.',
  },
  {
    pregunta: '¿Dónde comprar Gunpla original en México?',
    respuesta: `En el directorio hay ${verificadas.length} tiendas verificadas en ${totalEstados} estados, entre tiendas físicas, tiendas en línea y talleres. Cada ficha indica cómo se verificó, qué grados maneja y, cuando existe, un precio observado con su fecha.`,
  },
  {
    pregunta: '¿Cuántas series de Gundam hay?',
    respuesta: `La franquicia lleva más de cuarenta años y decenas de series, películas y OVAs. En este archivo hay ${todasSeries.length} obras documentadas con ficha completa, repartidas entre los ${universos.length} calendarios que tienen contenido publicado.`,
  },
];

const entradas = [
  { titulo: 'Universos', texto: 'Las líneas temporales de la franquicia, cada una con su calendario y su serie de entrada.', meta: `${universos.length} líneas documentadas`, href: '/universos/' },
  { titulo: 'Series', texto: 'Fichas por obra: año, formato, estudio, dirección y dónde encaja en su universo.', meta: `${todasSeries.length} obras en el archivo`, href: '/series/' },
  { titulo: 'Mobile suits', texto: 'Designación, fabricante, piloto y las máquinas relacionadas de cada época.', meta: `${ms.length} fichas técnicas`, href: '/mobile-suits/' },
  { titulo: 'Personajes', texto: 'Pilotos y facciones: quién conduce qué, de qué lado y en qué conflicto.', meta: `${pilotos.length} pilotos · ${facciones.length} facciones`, href: '/personajes/' },
  { titulo: 'Gunpla', texto: 'Los grados de los kits de Bandai por dificultad, escala y a quién le sirve cada uno.', meta: `${grados.length} grados explicados`, href: '/gunpla/' },
  { titulo: 'Tiendas verificadas', texto: 'Dónde comprar Gundam original en México, con fuentes de verificación y precios fechados.', meta: `${verificadas.length} verificadas · ${totalEstados} estados`, href: '/tiendas/' },
];
---

<BaseLayout
  titulo="Gundam México | Series, Gunpla y tiendas Gundam"
  descripcion="Gundam México: en qué orden ver las series de Gundam, dónde verlas, qué Gunpla comprar primero y el directorio de tiendas Gundam verificadas en todo el país."
  schemas={[schemaFAQ(faq)]}
>
  {destacado && (
    <EditorialHero
      sello={{ archivo: `Archivo ${SITE.nombre}`, actualizado: fechaCorta(destacado.data.fecha) }}
      titulo="Gundam en México:"
      destaque="qué ver, en qué orden y dónde comprarlo"
      entrada="Todo Gundam, ordenado para México. El orden para ver las series sin spoilers, en qué plataforma está cada una, quién es quién entre los mobile suits y sus pilotos, y qué Gunpla comprar primero —con el directorio de tiendas Gundam verificadas en el país."
      busqueda={{ sugerencia: 'Busca «orden para ver Gundam», «Gunpla para principiantes» o «tiendas en CDMX»' }}
      acciones={[
        { texto: 'Empieza por aquí', href: `/articulos/${destacado.id}/`, principal: true },
        { texto: 'Ver tiendas verificadas', href: '/tiendas/' },
      ]}
      contexto={{
        titulo: 'Qué vas a encontrar',
        parrafos: [
          'La franquicia arrancó en 1979 con <strong>Mobile Suit Gundam</strong> y hoy son <strong>siete líneas temporales independientes</strong>: Universal Century, After Colony, Cosmic Era, Anno Domini, Post Disaster, Ad Stella y Correct Century. Por eso <strong>en qué orden ver Gundam</strong> no tiene una sola respuesta. Damos tres rutas —empezar de cero, seguir el Universal Century o ver una historia cerrada como <strong>Wing</strong>, <strong>SEED</strong> o <strong>The Witch from Mercury</strong>— con la ficha de cada serie, sus mobile suits, sus pilotos y sus facciones.',
          'La otra mitad es el hobby. Explicamos qué es el <strong>Gunpla</strong> y en qué se diferencian los grados —<strong>Entry Grade, High Grade, Real Grade, Master Grade y Perfect Grade</strong>—, cuál conviene como primer kit y qué herramientas hacen falta. Y mantenemos el directorio de <strong>dónde comprar Gunpla original en México</strong>: tiendas en CDMX, Guadalajara, Monterrey y el resto del país, con precios fechados, talleres de pintura, eventos y comunidad.',
        ],
        masBuscado: [
          { texto: 'Orden para ver Gundam', href: '/articulos/en-que-orden-ver-gundam/' },
          { texto: 'Dónde ver Gundam', href: '/articulos/donde-ver-gundam-en-mexico/' },
          { texto: 'Gunpla para principiantes', href: '/gunpla/high-grade/' },
          { texto: 'Qué es el Universal Century', href: '/universos/uc/' },
          { texto: 'Tiendas en México', href: '/tiendas/' },
        ],
      }}
    />
  )}

  <UniverseTimeline filas={filasLinea} desde={primerAnio} hasta={ultimoAnio} />

  <EntryRow items={entradas} />

  <UniverseNavigator universos={universos} />

  <SeriesRail eyebrow="Series esenciales · Empieza aquí" titulo="Por dónde empezar a ver Gundam" series={empiezaAqui} verTodo={{ texto: 'Todas las series', href: '/series/' }} />

  <section class="grid-page py-16" aria-labelledby="ms-h">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="class-line">Mobile suits · fichas técnicas</p>
        <h2 id="ms-h" class="display mt-3 text-3xl md:text-4xl">Mobile suits: qué es cada máquina y quién la pilota</h2>
      </div>
      <a href="/mobile-suits/" class="link text-sm">Archivo completo</a>
    </div>
    <div class="mt-10 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {destacadosMS.map((m, i) => (
        <MobileSuitCard ms={m} folio={i + 1} faccion={n.facciones[m.data.faccion]} piloto={m.data.pilotos.map((p) => n.pilotos[p]).join(', ')} />
      ))}
    </div>
  </section>

  <TimelineGuide cronologia={cronologia} recomendado={recomendado} compacto />

  <SeriesRail eyebrow="Series esenciales · Profundiza en el Universal Century" titulo="Después de la primera" series={profundiza} />
  <SeriesRail eyebrow="Series esenciales · Líneas independientes" titulo="Series de Gundam que se ven sueltas" series={alternativas} />

  <section class="grid-page py-16" aria-labelledby="arch-h">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="class-line">Archivo editorial</p>
        <h2 id="arch-h" class="display mt-3 text-3xl md:text-4xl">Guías y explicadores sobre Gundam</h2>
      </div>
      <a href="/articulos/" class="link text-sm">Todos los artículos</a>
    </div>
    <div class="mt-10 grid gap-x-12 gap-y-2 lg:grid-cols-2">
      {archivo.map((a, i) => <ArchiveCard articulo={a} grande={i === 0} folio={i + 1} />)}
    </div>
  </section>

  <section class="grid-page py-16" aria-labelledby="faq-home">
    <p class="class-line">Preguntas frecuentes</p>
    <div class="mt-8 grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="faq-home" class="display text-3xl md:text-4xl text-balance">Las dudas con las que casi todos llegan</h2>
        <p class="mt-4 text-ink-2 text-pretty">Respuestas cortas a lo que más se pregunta sobre la franquicia y sobre el hobby en México. Cada una lleva a la ficha o a la guía donde está el detalle.</p>
      </div>
      <div class="lg:col-span-8"><FAQ items={faq} titulo="Sobre Gundam, el Gunpla y dónde comprarlo" /></div>
    </div>
  </section>

  <GunplaBlock grados={grados} totalTiendas={tiendas.length} totalVerificadas={verificadas.length} guias={guias.map((g) => ({ titulo: g.data.titulo, href: `/guias/${g.id}/` }))} />

  <NewsletterCTA />
</BaseLayout>

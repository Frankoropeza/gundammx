---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/EditorialHero.astro';
import UniverseNavigator from '@components/UniverseNavigator.astro';
import SeriesRail from '@components/SeriesRail.astro';
import MobileSuitCard from '@components/MobileSuitCard.astro';
import TimelineGuide from '@components/TimelineGuide.astro';
import ArchiveCard from '@components/ArchiveCard.astro';
import GunplaBlock from '@components/GunplaBlock.astro';
import EntryRow from '@components/EntryRow.astro';
import UniverseTimeline from '@components/UniverseTimeline.astro';
import NewsletterCTA from '@components/NewsletterCTA.astro';
import { universosConContenido, seriesOrdenRecomendado, seriesCronologiaUC, seriesPorRuta, nombres, publicado } from '@lib/archivo';
import { tiendasActivas, tiendasVerificadas, estadosConTiendas } from '@lib/directorio';
import { SITE } from '@config/site';
import { fechaCorta } from '@lib/precio';

const universos = await universosConContenido();
const recomendado = (await seriesOrdenRecomendado()).slice(0, 8);
const cronologia = await seriesCronologiaUC();
const empiezaAqui = await seriesPorRuta('empieza-aqui');
const profundiza = await seriesPorRuta('profundiza');
const alternativas = await seriesPorRuta('alternativa');

const ms = (await getCollection('mobile-suits', publicado)).sort((a, b) => a.data.codigo.localeCompare(b.data.codigo));
const destacadosMS = ['rx-78-2-gundam', 'ms-06-zaku-ii', 'xxxg-01w-wing-gundam', 'rx-0-unicorn-gundam', 'asw-g-08-gundam-barbatos', 'xvx-016-gundam-aerial']
  .map((id) => ms.find((m) => m.id === id)).filter(Boolean) as typeof ms;
const n = await nombres();

const articulos = (await getCollection('articles', ({ data }) => !data.borrador)).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const destacado = articulos.find((a) => a.data.destacado) ?? articulos[0];
const archivo = articulos.filter((a) => a.id !== destacado?.id).slice(0, 5);

const grados = (await getCollection('gunpla', publicado)).sort((a, b) => a.data.orden - b.data.orden);
const guias = (await getCollection('guides', ({ data }) => !data.borrador)).sort((a, b) => a.data.orden - b.data.orden).slice(0, 4);
const tiendas = await tiendasActivas();
const verificadas = await tiendasVerificadas();
const estados = await estadosConTiendas();
const totalEstados = estados.size;
const pilotos = await getCollection('pilots', publicado);
const facciones = await getCollection('factions', publicado);
const todasSeries = await getCollection('series', publicado);

const aniosSerie = todasSeries.map((x) => x.data.anio);
const primerAnio = Math.min(...aniosSerie);
const ultimoAnio = Math.max(...aniosSerie);

const filasLinea = universos.map((u) => ({
  universo: u.data.abreviatura,
  nombre: u.data.nombre,
  href: `/universos/${u.id}/`,
  obras: todasSeries
    .filter((x) => x.data.universo === u.data.abreviatura)
    .sort((a, b) => a.data.anio - b.data.anio)
    .map((x) => ({ titulo: x.data.titulo, anio: x.data.anio, href: `/series/${x.id}/` })),
}));

const entradas = [
  { titulo: 'Universos', texto: 'Las líneas temporales de la franquicia, cada una con su calendario y su serie de entrada.', meta: `${universos.length} líneas documentadas`, href: '/universos/' },
  { titulo: 'Series', texto: 'Fichas por obra: año, formato, estudio, dirección y dónde encaja en su universo.', meta: `${todasSeries.length} obras en el archivo`, href: '/series/' },
  { titulo: 'Mobile suits', texto: 'Designación, fabricante, piloto y las máquinas relacionadas de cada época.', meta: `${ms.length} fichas técnicas`, href: '/mobile-suits/' },
  { titulo: 'Personajes', texto: 'Pilotos y facciones: quién conduce qué, de qué lado y en qué conflicto.', meta: `${pilotos.length} pilotos · ${facciones.length} facciones`, href: '/personajes/' },
  { titulo: 'Gunpla', texto: 'Los grados de los kits de Bandai por dificultad, escala y a quién le sirve cada uno.', meta: `${grados.length} grados explicados`, href: '/gunpla/' },
  { titulo: 'Tiendas verificadas', texto: 'Dónde comprar Gundam original en México, con fuentes de verificación y precios fechados.', meta: `${verificadas.length} verificadas · ${totalEstados} estados`, href: '/tiendas/' },
];
---

<BaseLayout
  titulo="Gundam en español: por dónde empezar, qué ver y dónde comprar en México"
  descripcion="Archivo independiente de Gundam en español: los siete universos explicados, fichas de series y mobile suits con fuentes, guías de Gunpla por grado y tiendas verificadas en México."
>
  {destacado && (
    <EditorialHero
      sello={{ archivo: `Archivo ${SITE.nombre}`, actualizado: fechaCorta(destacado.data.fecha) }}
      titulo="Entra a Gundam por"
      destaque="la puerta correcta"
      entrada="Cuarenta y siete años de series, siete calendarios que no se cruzan y listas de internet que se contradicen entre sí. Este archivo ordena la franquicia en español: qué ver primero según lo que te guste, qué mobile suit es cuál y en qué tienda mexicana comprar Gunpla original sin pagar de más."
      busqueda={{ sugerencia: 'Prueba «Universal Century», «Master Grade» o «Guadalajara»' }}
      acciones={[
        { texto: 'Empieza por aquí', href: `/articulos/${destacado.id}/`, principal: true },
        { texto: 'Ver tiendas verificadas', href: '/tiendas/' },
      ]}
      contexto={{
        titulo: 'Qué vas a encontrar',
        parrafos: [
          'Gundam empezó en 1979 con una serie sobre una guerra entre la Tierra y sus colonias, y hoy son <strong>siete líneas temporales independientes</strong>: Universal Century, After Colony, Cosmic Era, Anno Domini, Post Disaster, Ad Stella y Correct Century. Cada una se puede ver por separado, y por eso la pregunta de <strong>en qué orden ver Gundam</strong> no tiene una sola respuesta: aquí hay tres rutas —empezar de cero, profundizar en el UC o irte por una historia cerrada— con la ficha de cada serie, sus mobile suits, sus pilotos y sus facciones.',
          'La otra mitad es el hobby y el mercado mexicano. Explicamos <strong>Gunpla</strong> —los kits armables de Bandai— grado por grado, de Entry Grade y High Grade a Real Grade, Master Grade y Perfect Grade: qué trae cada caja, cuánta paciencia pide y con qué herramientas. Y mantenemos el directorio de <strong>dónde comprar Gundam original en México</strong>, tienda por tienda, con precios fechados, talleres de pintura, eventos y comunidad.',
        ],
        masBuscado: [
          { texto: 'En qué orden ver Gundam', href: '/articulos/en-que-orden-ver-gundam/' },
          { texto: 'Universal Century', href: '/universos/uc/' },
          { texto: 'High Grade', href: '/gunpla/high-grade/' },
          { texto: 'RX-78-2', href: '/mobile-suits/rx-78-2-gundam/' },
          { texto: 'Tiendas verificadas', href: '/tiendas/' },
        ],
      }}
      lectura={{
        eyebrow: `Expediente destacado · ${fechaCorta(destacado.data.fecha)}`,
        titulo: destacado.data.titulo,
        resumen: destacado.data.resumen,
        href: `/articulos/${destacado.id}/`,
        meta: `${destacado.data.lectura_min} min de lectura · ${destacado.data.referencias.length} referencias`,
      }}
    />
  )}

  <UniverseTimeline filas={filasLinea} desde={primerAnio} hasta={ultimoAnio} />

  <EntryRow items={entradas} />

  <UniverseNavigator universos={universos} />

  <SeriesRail eyebrow="Series esenciales · Empieza aquí" titulo="Cuatro puertas de entrada" series={empiezaAqui} verTodo={{ texto: 'Todas las series', href: '/series/' }} />

  <section class="grid-page py-16" aria-labelledby="ms-h">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="class-line">Mobile suits · fichas técnicas</p>
        <h2 id="ms-h" class="display mt-3 text-3xl md:text-4xl">Las máquinas que definen cada época</h2>
      </div>
      <a href="/mobile-suits/" class="link text-sm">Archivo completo</a>
    </div>
    <div class="mt-10 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {destacadosMS.map((m, i) => (
        <MobileSuitCard ms={m} folio={i + 1} faccion={n.facciones[m.data.faccion]} piloto={m.data.pilotos.map((p) => n.pilotos[p]).join(', ')} />
      ))}
    </div>
  </section>

  <TimelineGuide cronologia={cronologia} recomendado={recomendado} compacto />

  <SeriesRail eyebrow="Series esenciales · Profundiza en el Universal Century" titulo="Después de la primera" series={profundiza} />
  <SeriesRail eyebrow="Series esenciales · Líneas independientes" titulo="Alternativas que no piden contexto" series={alternativas} />

  <section class="grid-page py-16" aria-labelledby="arch-h">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="class-line">Archivo editorial</p>
        <h2 id="arch-h" class="display mt-3 text-3xl md:text-4xl">Explicadores, análisis y guías</h2>
      </div>
      <a href="/articulos/" class="link text-sm">Todos los artículos</a>
    </div>
    <div class="mt-10 grid gap-x-12 gap-y-2 lg:grid-cols-2">
      {archivo.map((a, i) => <ArchiveCard articulo={a} grande={i === 0} folio={i + 1} />)}
    </div>
  </section>

  <GunplaBlock grados={grados} totalTiendas={tiendas.length} totalVerificadas={verificadas.length} guias={guias.map((g) => ({ titulo: g.data.titulo, href: `/guias/${g.id}/` }))} />

  <NewsletterCTA />
</BaseLayout>

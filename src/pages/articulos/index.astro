---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ArchiveCard from '@components/ArchiveCard.astro';
import { schemaColeccion, schemaMigaDePan } from '@lib/seo';
const articulos = (await getCollection('articles', ({ data }) => !data.borrador)).sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Artículos', href: '/articulos/' }];
const schemas = [schemaMigaDePan(base, migas), schemaColeccion(base, { nombre: 'Artículos', descripcion: 'Explicadores, análisis y guías.', items: articulos.map((a) => ({ nombre: a.data.titulo, href: `/articulos/${a.id}/` })) })];
import HubImagen from '@components/HubImagen.astro';
import imgArticulos from '../../assets/hub-articulos.jpg';
---
<BaseLayout titulo="Guías de Gundam | Explicadores y análisis" descripcion="Guías y explicadores de Gundam con referencias: qué es cada universo, en qué orden ver la franquicia, dónde verla y cómo llegó Gundam a México." schemas={schemas}>
  <Breadcrumbs items={migas} />

  <HubImagen src={imgArticulos} id="hub-articulos" />
  <div class="grid-page py-10">
    <p class="class-line">Archivo editorial</p>
    <h1 class="display mt-3 text-4xl md:text-5xl">Artículos</h1>
    <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">Redacción propia, con referencias visibles al pie de cada texto. Nada de resúmenes de wiki ni de traducciones de comunicados.</p>
    <section class="mt-10" aria-labelledby="lista-articulos">
      <h2 id="lista-articulos" class="display text-2xl md:text-3xl">Guías y explicadores publicados</h2>
      <div class="mt-6 grid gap-x-12 gap-y-2 lg:grid-cols-2">{articulos.map((a, i) => <ArchiveCard articulo={a} grande={i === 0} folio={i + 1} />)}</div>
    </section>
  </div>
</BaseLayout>

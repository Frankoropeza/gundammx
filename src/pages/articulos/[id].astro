---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
import RelatedContent from '@components/RelatedContent.astro';
import InvitacionForo from '@components/InvitacionForo.astro';
import ArticleEditorialHero from '@components/ArticleEditorialHero.astro';
import ArticleTableOfContents from '@components/ArticleTableOfContents.astro';
import ArticleContextSidebar from '@components/ArticleContextSidebar.astro';
import { entradasPorIds, nombreUniverso, FORMATO } from '@lib/archivo';
import { fechaLarga, pesos } from '@lib/precio';
import { componerTitulo, schemaArticulo, schemaFAQ, schemaMigaDePan, descripcionFicha } from '@lib/seo';
import { CATEGORIAS } from '@config/categorias';
import { categoriasAbiertas, urlCategoria } from '@lib/categorias';
import { categoriaForoArticulo } from '@lib/foro';
import { tiendasActivas } from '@lib/directorio';
import { seleccionarArticulosRelacionados } from '@lib/articulos-relacionados';

export const getStaticPaths = (async () => {
  const rutaPrimerGunpla = [
    'que-es-un-gunpla',
    'entry-grade-que-es',
    'como-armar-tu-primer-gunpla',
    'herramientas-para-armar-gunpla',
  ];
  const [articulos, grados, kits, tiendas] = await Promise.all([
    getCollection('articles', ({ data }) => !data.borrador),
    getCollection('gunpla'),
    getCollection('kits'),
    tiendasActivas(),
  ]);
  const abiertas = (await categoriasAbiertas()).map((c) => c.id);
  return Promise.all(articulos.map(async (a) => ({
    params: { id: a.id },
    props: {
      articulo: a,
      series: await entradasPorIds('series', a.data.series),
      otros: seleccionarArticulosRelacionados(a, articulos, 5),
      ruta: rutaPrimerGunpla.map((id) => articulos.find((articulo) => articulo.id === id)).filter(Boolean),
      grados: grados.sort((x, y) => x.data.orden - y.data.orden),
      kitsRelacionados: kits.filter((kit) => a.data.kits_relacionados.includes(kit.id)),
      tiendasRelacionadas: tiendas.filter((tienda) => a.data.tiendas_relacionadas.includes(tienda.id)),
      hubAbierto: abiertas.includes(a.data.categoria),
    },
  })));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { articulo, series, otros, ruta, grados, kitsRelacionados, tiendasRelacionadas, hubAbierto } = Astro.props;
const d = articulo.data;
const { Content, headings } = await render(articulo);
const categoria = CATEGORIAS[d.categoria];
const plantillaEditorial = articulo.id === 'entry-grade-que-es';
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Artículos', href: '/articulos/' },
  ...(hubAbierto ? [{ nombre: categoria.nombre, href: urlCategoria(d.categoria) }] : []),
  { nombre: d.titulo, href: `/articulos/${articulo.id}/` },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaArticulo(base, {
    titulo: d.titulo,
    descripcion: d.resumen,
    fecha: d.fecha,
    actualizada: d.actualizada && !Number.isNaN(Date.parse(d.actualizada)) ? new Date(d.actualizada) : undefined,
    autor: d.autor,
  }),
  ...(d.faq.length ? [schemaFAQ(d.faq)] : []),
];
const tituloSeo = d.seo?.titulo ?? componerTitulo(d.titulo, categoria.nombre);
const descripcionSeo = d.seo?.descripcion ?? descripcionFicha(d.resumen, 'Guía publicada en Gundam México.');
const categoriaForo = categoriaForoArticulo(d);
const actualizada = d.actualizada && !Number.isNaN(Date.parse(d.actualizada)) && d.actualizada !== d.fecha.toISOString().slice(0, 10)
  ? d.actualizada
  : undefined;
const nivel = d.nivel ? d.nivel.charAt(0).toUpperCase() + d.nivel.slice(1) : 'General';
const rutaSidebar = ruta.map((item) => ({
  titulo: item!.data.titulo,
  href: `/articulos/${item!.id}/`,
  actual: item!.id === articulo.id,
}));
const gradosSidebar = grados.map((grado) => ({
  titulo: `${grado.data.etiqueta} · ${grado.data.nombre}`,
  href: `/gunpla/${grado.id}/`,
  meta: grado.data.escala,
  actual: grado.id === 'entry-grade',
}));
const kitsSidebar = kitsRelacionados.map((kit) => {
  const observado = [...kit.data.precio_mx_observado].sort((a, b) => b.fecha.localeCompare(a.fecha))[0];
  return {
    titulo: kit.data.nombre,
    href: `/kit/${kit.id}/`,
    meta: observado ? `${pesos(observado.monto)} · observado ${fechaLarga(observado.fecha)}` : kit.data.escala,
  };
});
const tiendasSidebar = tiendasRelacionadas.map((tienda) => ({
  titulo: tienda.data.nombre,
  href: `/tienda/${tienda.id}/`,
  meta: `${tienda.data.descripcion_corta}${tienda.data.envio_nacional ? ' Envío nacional registrado.' : ''}`,
}));
const relacionadosSidebar = otros.map((item) => ({
  titulo: item.data.titulo,
  href: `/articulos/${item.id}/`,
  meta: `${CATEGORIAS[item.data.categoria].nombre} · ${item.data.lectura_min} min`,
}));
---
<BaseLayout titulo={tituloSeo} descripcion={descripcionSeo} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  {plantillaEditorial ? (
    <article>
      <ArticleEditorialHero
        categoria={categoria.nombre}
        fecha={fechaLarga(d.fecha)}
        actualizada={actualizada ? fechaLarga(actualizada) : undefined}
        lectura={d.lectura_min}
        titulo={d.titulo}
        resumen={d.resumen}
        autor={d.autor}
        nivel={nivel}
        referencias={d.referencias.length}
        aprendizajes={[
          'Qué cambia cuando las piezas pueden separarse del marco sin comprar herramientas.',
          'Cómo comparar Entry Grade con High Grade sin tratar un grado como mejor que el otro.',
          'En qué casos funciona como primer kit y cuándo conviene pasar directo a High Grade.',
          'Qué revisar antes de elegir un modelo y cuál puede ser el siguiente paso del hobby.',
        ]}
        etiquetas={[
          { texto: 'Principiante' },
          { texto: 'Escala 1/144', href: '/articulos/escalas-de-gunpla-explicadas/' },
          { texto: 'Entry Grade', href: '/gunpla/entry-grade/' },
          { texto: 'Sin pegamento' },
        ]}
        acciones={[
          { texto: 'Comparar todos los grados', href: '/articulos/grados-de-gunpla/', principal: true },
          { texto: 'Ver kits Entry Grade', href: '/gunpla/entry-grade/' },
        ]}
        imagen={d.imagen}
        imagenAlt={d.imagen_alt}
        imagenCredito={d.imagen_credito}
        codigo={`ART-${articulo.id.toUpperCase().slice(0, 18)}`}
      />

      <div class="grid-page py-10 md:py-14 lg:py-16">
        <ArticleTableOfContents headings={headings} movil />
        <div class="mt-8 grid gap-12 lg:mt-0 lg:grid-cols-12 lg:gap-16">
          <div class="min-w-0 lg:col-span-8">
            <div class="prose-ed prose-ed-ancha"><Content /></div>
            {d.faq.length > 0 && (
              <section class="mt-14 border-t border-line pt-8">
                <p class="class-line">Respuestas rápidas</p>
                <h2 class="display mt-4 text-3xl">Preguntas frecuentes</h2>
                <dl class="mt-7 divide-y divide-line border-y border-line">
                  {d.faq.map((f, index) => (
                    <div class="grid gap-2 py-6 sm:grid-cols-[2rem_1fr] sm:gap-4">
                      <span class="folio pt-1">{String(index + 1).padStart(2, '0')}</span>
                      <div>
                        <dt class="font-medium text-ink">{f.pregunta}</dt>
                        <dd class="mt-2 leading-relaxed text-ink-2 text-pretty">{f.respuesta}</dd>
                      </div>
                    </div>
                  ))}
                </dl>
              </section>
            )}
            <section class="mt-14 border-t border-line pt-8" data-pagefind-ignore>
              <h2 class="class-line">Fuentes consultadas</h2>
              <ol class="mt-5 space-y-3 text-sm">
                {d.referencias.map((r, i) => (
                  <li class="grid grid-cols-[2rem_1fr] gap-3">
                    <span class="folio">{String(i + 1).padStart(2, '0')}</span>
                    <a href={r.url} class="link" rel="nofollow noopener" target="_blank">{r.titulo}</a>
                  </li>
                ))}
              </ol>
            </section>
            <InvitacionForo categoria={categoriaForo} class="mt-14 lg:hidden" />
          </div>

          <ArticleContextSidebar
            headings={headings}
            ruta={rutaSidebar}
            grados={gradosSidebar}
            kits={kitsSidebar}
            tiendas={tiendasSidebar}
            relacionados={relacionadosSidebar}
            categoriaForo={categoriaForo}
          />
        </div>
      </div>
    </article>
  ) : (
  <article class="grid-page py-10">
    <header class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="class-line">{categoria.nombre} · {fechaLarga(d.fecha)}{actualizada && ` · Actualizado el ${fechaLarga(actualizada)}`} · {d.lectura_min} min de lectura</p>
        <h1 class="display mt-4 text-4xl md:text-5xl text-balance">{d.titulo}</h1>
        <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
        <MetadataRow class="mt-8" items={[{ etiqueta: 'Autoría', valor: d.autor }, { etiqueta: 'Universos', valor: d.universos.map((u) => nombreUniverso(u)).join(', ') }, { etiqueta: 'Referencias', valor: String(d.referencias.length) }]} />
      </div>
      <div class="lg:col-span-5"><Figura sizes="(min-width: 1024px) 42vw, 100vw" src={d.imagen} alt={d.imagen_alt} credito={d.imagen_credito} codigo={`ART-${articulo.id.toUpperCase().slice(0, 18)}`} prioridad ratio="aspect-[4/3]" /></div>
    </header>
    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose-ed"><Content /></div>
        {d.faq.length > 0 && (
          <section class="mt-12 border-t border-line pt-6">
            <h2 class="display text-2xl">Preguntas frecuentes</h2>
            <dl class="mt-5 space-y-5">
              {d.faq.map((f) => (
                <div>
                  <dt class="font-medium text-ink">{f.pregunta}</dt>
                  <dd class="mt-1 max-w-prose text-ink-2 text-pretty">{f.respuesta}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        <section class="mt-12 border-t border-line pt-6" data-pagefind-ignore>
          <h2 class="class-line">Referencias</h2>
          <ol class="mt-3 space-y-1 text-sm">{d.referencias.map((r, i) => <li><span class="folio mr-2">{String(i + 1).padStart(2, '0')}</span><a href={r.url} class="link" rel="nofollow noopener" target="_blank">{r.titulo}</a></li>)}</ol>
        </section>
        <InvitacionForo categoria={categoriaForo} class="mt-12" />
      </div>
      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
        <InvitacionForo categoria={categoriaForo} variante="tarjeta" class="hidden lg:block" />
        <RelatedContent titulo="Series citadas" items={series.map((s) => ({ eyebrow: `${s.data.anio} · ${FORMATO[s.data.formato]}`, titulo: s.data.titulo, href: `/series/${s.id}/` }))} />
        <RelatedContent titulo="Seguir leyendo" items={otros.map((o) => ({ eyebrow: CATEGORIAS[o.data.categoria].nombre, titulo: o.data.titulo, href: `/articulos/${o.id}/` }))} />
      </aside>
    </div>
  </article>
  )}
</BaseLayout>

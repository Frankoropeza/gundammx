---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Figura from '@components/Figura.astro';
import MetadataRow from '@components/MetadataRow.astro';
import RelatedContent from '@components/RelatedContent.astro';
import InvitacionForo from '@components/InvitacionForo.astro';
import { entradasPorIds, nombreUniverso, FORMATO } from '@lib/archivo';
import { fechaLarga } from '@lib/precio';
import { schemaArticulo, schemaFAQ, schemaMigaDePan, tituloEditorial, descripcionFicha } from '@lib/seo';
import { CATEGORIAS } from '@config/categorias';
import { categoriasAbiertas, urlCategoria } from '@lib/categorias';
import { categoriaForoArticulo } from '@lib/foro';

export const getStaticPaths = (async () => {
  const articulos = await getCollection('articles', ({ data }) => !data.borrador);
  const abiertas = (await categoriasAbiertas()).map((c) => c.id);
  return Promise.all(articulos.map(async (a) => ({
    params: { id: a.id },
    props: {
      articulo: a,
      series: await entradasPorIds('series', a.data.series),
      otros: articulos.filter((o) => o.id !== a.id).slice(0, 3),
      hubAbierto: abiertas.includes(a.data.categoria),
    },
  })));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { articulo, series, otros, hubAbierto } = Astro.props;
const d = articulo.data;
const { Content } = await render(articulo);
const categoria = CATEGORIAS[d.categoria];
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Artículos', href: '/articulos/' },
  ...(hubAbierto ? [{ nombre: categoria.nombre, href: urlCategoria(d.categoria) }] : []),
  { nombre: d.titulo, href: `/articulos/${articulo.id}/` },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaArticulo(base, {
    titulo: d.titulo,
    descripcion: d.resumen,
    fecha: d.fecha,
    actualizado: d.actualizada ? new Date(d.actualizada) : undefined,
    autor: d.autor,
  }),
  ...(d.faq.length ? [schemaFAQ(d.faq)] : []),
];
const tituloSeo = d.seo?.titulo ?? tituloEditorial(d.titulo, categoria.nombre);
const descripcionSeo = d.seo?.descripcion ?? descripcionFicha(d.resumen, 'Guía publicada en Gundam México.');
const categoriaForo = categoriaForoArticulo(d);
---
<BaseLayout titulo={tituloSeo} descripcion={descripcionSeo} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page py-10">
    <header class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="class-line">{categoria.nombre} · {fechaLarga(d.fecha)} · {d.lectura_min} min de lectura</p>
        <h1 class="display mt-4 text-4xl md:text-5xl text-balance">{d.titulo}</h1>
        <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
        <MetadataRow class="mt-8" items={[{ etiqueta: 'Autoría', valor: d.autor }, { etiqueta: 'Universos', valor: d.universos.map((u) => nombreUniverso(u)).join(', ') }, { etiqueta: 'Referencias', valor: String(d.referencias.length) }]} />
      </div>
      <div class="lg:col-span-5"><Figura src={d.imagen} alt={d.imagen_alt} credito={d.imagen_credito} codigo={`ART-${articulo.id.toUpperCase().slice(0, 18)}`} prioridad ratio="aspect-[4/3]" /></div>
    </header>
    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose-ed"><Content /></div>
        {d.faq.length > 0 && (
          <section class="mt-12 border-t border-line pt-6">
            <h2 class="display text-2xl">Preguntas frecuentes</h2>
            <dl class="mt-5 space-y-5">
              {d.faq.map((f) => (
                <div>
                  <dt class="font-medium text-ink">{f.pregunta}</dt>
                  <dd class="mt-1 max-w-prose text-ink-2 text-pretty">{f.respuesta}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        <section class="mt-12 border-t border-line pt-6" data-pagefind-ignore>
          <h2 class="class-line">Referencias</h2>
          <ol class="mt-3 space-y-1 text-sm">{d.referencias.map((r, i) => <li><span class="folio mr-2">{String(i + 1).padStart(2, '0')}</span><a href={r.url} class="link" rel="nofollow noopener" target="_blank">{r.titulo}</a></li>)}</ol>
        </section>
        <InvitacionForo categoria={categoriaForo} class="mt-12" />
      </div>
      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
        <InvitacionForo categoria={categoriaForo} variante="tarjeta" class="hidden lg:block" />
        <RelatedContent titulo="Series citadas" items={series.map((s) => ({ eyebrow: `${s.data.anio} · ${FORMATO[s.data.formato]}`, titulo: s.data.titulo, href: `/series/${s.id}/` }))} />
        <RelatedContent titulo="Seguir leyendo" items={otros.map((o) => ({ eyebrow: CATEGORIAS[o.data.categoria].nombre, titulo: o.data.titulo, href: `/articulos/${o.id}/` }))} />
      </aside>
    </div>
  </article>
</BaseLayout>

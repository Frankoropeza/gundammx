---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PageHeader from '@components/PageHeader.astro';
import ArchiveCard from '@components/ArchiveCard.astro';
import { categoriasAbiertas, urlCategoria } from '@lib/categorias';
import { componerTitulo, schemaColeccion, schemaMigaDePan } from '@lib/seo';

export const getStaticPaths = (async () => {
  const abiertas = await categoriasAbiertas();
  return abiertas.map((c) => ({ params: { categoria: c.id }, props: { cat: c } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { cat } = Astro.props;
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Artículos', href: '/articulos/' },
  { nombre: cat.meta.nombre, href: urlCategoria(cat.id) },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaColeccion(base, {
    nombre: cat.meta.nombre,
    descripcion: cat.meta.descripcion,
    items: cat.piezas.map((a) => ({ nombre: a.data.titulo, href: `/articulos/${a.id}/` })),
  }),
];
---
<BaseLayout titulo={componerTitulo(cat.meta.nombre, 'Gundam México')} descripcion={cat.meta.meta} schemas={schemas}>
  <Breadcrumbs items={migas} />
  <PageHeader
    sello="Archivo editorial · Categoría"
    titulo={cat.meta.nombre}
    entrada={cat.meta.intro}
    meta={`${cat.piezas.length} ${cat.piezas.length === 1 ? 'pieza publicada' : 'piezas publicadas'}`}
  />
  <div class="grid-page py-12 md:py-16">
    <section aria-labelledby="lista-categoria">
      <h2 id="lista-categoria" class="sr-only">Piezas publicadas en {cat.meta.nombre}</h2>
      <div class="mt-6 grid gap-x-12 gap-y-2 lg:grid-cols-2">
        {cat.piezas.map((a, i) => <ArchiveCard articulo={a} grande={i === 0} folio={i + 1} />)}
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TimelineGuide from '@components/TimelineGuide.astro';
import { seriesOrdenRecomendado, seriesCronologiaUC, universosConContenido } from '@lib/archivo';
import { schemaArticulo, schemaMigaDePan } from '@lib/seo';
const recomendado = await seriesOrdenRecomendado();
const cronologia = await seriesCronologiaUC();
const universos = await universosConContenido();
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Cronología', href: '/cronologia/' }];
const schemas = [schemaMigaDePan(base, migas), schemaArticulo(base, { titulo: 'En qué orden ver Gundam', descripcion: 'Orden recomendado para empezar y cronología interna del Universal Century, separados.', fecha: new Date('2026-09-05') })];
---
<BaseLayout titulo="Línea de tiempo de Gundam: cronología por universo" descripcion="Línea de tiempo de Gundam por universo: ubica series, películas y eventos dentro de cada continuidad, con foco en la cronología del Universal Century." schemas={schemas}>
  <Breadcrumbs items={migas} />
  <div class="grid-page pt-10">
    <p class="class-line">Guía de entrada</p>
    <h1 class="display mt-3 text-4xl md:text-5xl text-balance">Línea de tiempo de Gundam</h1>
    <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">La franquicia tiene siete calendarios independientes. Esta línea de tiempo ubica obras y acontecimientos por universo; si buscas una recomendación de entrada, consulta <a href="/articulos/en-que-orden-ver-gundam/" class="link">en qué orden ver Gundam</a>.</p>
  </div>
  <TimelineGuide cronologia={cronologia} recomendado={recomendado} />
  <section class="grid-page pb-16" aria-labelledby="alt-h">
    <h2 id="alt-h" class="class-line">Líneas independientes: por dónde entra cada una</h2>
    <p class="mt-3 max-w-prose text-sm text-ink-2">El Universal Century queda fuera de esta lista porque no es una puerta de entrada suelta, sino una línea continua: tiene <a href="/universos/uc/" class="link">guía propia con su orden de visionado</a>.</p>
    <ol class="mt-5 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {universos.filter((u) => u.data.abreviatura !== 'uc').map((u) => (
        <li class="card p-6"><p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-3">{u.data.abreviatura.toUpperCase()} · {u.data.periodo}</p><h3 class="display mt-3 text-2xl"><a href={`/universos/${u.id}/`} class="link-quiet">{u.data.nombre}</a></h3><p class="mt-2 text-sm text-ink-2">Empieza por <a href={`/series/${u.data.serie_de_entrada}/`} class="link">la serie de entrada</a>.</p></li>
      ))}
    </ol>
  </section>
</BaseLayout>

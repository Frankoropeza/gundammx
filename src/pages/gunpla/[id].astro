---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import MetadataRow from '@components/MetadataRow.astro';
import KitCard from '@components/KitCard.astro';
import RelatedContent from '@components/RelatedContent.astro';
import { fechaLarga } from '@lib/precio';
import { schemaFicha, schemaMigaDePan, descripcionFicha } from '@lib/seo';

export const getStaticPaths = (async () => {
  const grados = (await getCollection('gunpla')).sort((a, b) => a.data.orden - b.data.orden);
  const kits = await getCollection('kits');
  return grados.map((g, i) => ({
    params: { id: g.id },
    props: { grado: g, kits: kits.filter((k) => k.data.grado === g.data.etiqueta.toLowerCase()), otros: grados.filter((_, j) => j !== i) },
  }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { grado, kits, otros } = Astro.props;
const d = grado.data;
const { Content } = await render(grado);
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Gunpla', href: '/gunpla/' }, { nombre: d.nombre, href: `/gunpla/${grado.id}/` }];
const schemas = [schemaMigaDePan(base, migas), schemaFicha(base, { nombre: `${d.nombre} (${d.etiqueta})`, descripcion: d.resumen, fecha: d.actualizado })];
---
<BaseLayout noindex={d.estado_editorial === 'borrador'} titulo={`${d.nombre} ${d.etiqueta} | Grado de Gunpla en México`} descripcion={descripcionFicha(d.resumen, 'Grado de Gunpla explicado en Gundam México.')} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page grid gap-10 py-10 lg:grid-cols-12">
    <header class="lg:col-span-8">
      <p class="archive-code">{d.codigo}</p>
      <p class="mt-4 font-mono text-lg tracking-wide text-ink">{d.etiqueta}</p>
      <h1 class="display mt-1 text-4xl md:text-5xl">{d.nombre}</h1>
      <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
      <MetadataRow class="mt-8" items={[{ etiqueta: 'Escala', valor: d.escala }, { etiqueta: 'Línea desde', valor: String(d.anio_lanzamiento) }, { etiqueta: 'Dificultad', valor: d.dificultad }, { etiqueta: 'Para quién', valor: d.para_quien }]} />
    </header>
    <div class="prose-ed lg:col-span-7"><Content /></div>
    <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
      <RelatedContent titulo="Otros grados" items={otros.map((o) => ({ eyebrow: `${o.data.etiqueta} · ${o.data.escala}`, titulo: o.data.nombre, href: `/gunpla/${o.id}/` }))} />
      <section class="border-t border-line pt-6"><h2 class="class-line">Fuentes</h2><ul class="mt-3 space-y-1">{d.fuentes.map((f) => <li class="truncate text-sm"><a href={f} class="link" rel="nofollow noopener" target="_blank">{f}</a></li>)}</ul><p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Actualizado {fechaLarga(d.actualizado)}</p></section>
    </aside>
    {kits.length > 0 && (
      <section class="lg:col-span-12"><h2 class="class-line">Kits {d.etiqueta} con precio de referencia en México</h2><div class="mt-5 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4">{kits.map((k) => <KitCard kit={k} />)}</div></section>
    )}
  </article>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { schemaNoticia, schemaMigaDePan, tituloEditorial, descripcionFicha } from '@lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const notas = await getCollection('noticias', ({ data }) => !data.borrador);
  return notas.map((n) => ({ params: { slug: n.id }, props: { nota: n } }));
};

interface Props { nota: CollectionEntry<'noticias'> }

const { nota } = Astro.props;
const d = nota.data;
const { Content } = await render(nota);

// fuente_nombre y fuente_url solo existen en notas sobre terceros;
// los avisos propios (categoria: directorio) van sin fuente.
const fuente = d.fuente_nombre && d.fuente_url
  ? { nombre: d.fuente_nombre, url: d.fuente_url }
  : undefined;

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Noticias', href: '/noticias/' },
  { nombre: d.titulo, href: `/noticias/${nota.id}/` },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaNoticia(base, {
    titulo: d.titulo,
    descripcion: d.descripcion,
    fecha: d.fecha,
    autor: d.autor,
    fuenteUrl: d.fuente_url,
  }),
];
---

<ArticleLayout
  titulo={tituloEditorial(d.titulo, 'mexico')}
  descripcion={descripcionFicha(d.descripcion, 'Noticia de Gundam en México.')}
  fecha={d.fecha}
  migas={migas}
  fuente={fuente}
  schemas={schemas}
>
  <Content />
</ArticleLayout>

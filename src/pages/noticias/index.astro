---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TarjetaNoticia from '@components/TarjetaNoticia.astro';
import { getCollection } from 'astro:content';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

const notas = (await getCollection('noticias', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Noticias', href: '/noticias/' }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, 'Noticias de Gundam y Gunpla en México',
    notas.map((n) => ({ nombre: n.data.titulo, href: `/noticias/${n.id}/` }))),
];
---

<BaseLayout
  titulo="Noticias de Gundam y Gunpla en México"
  descripcion="Lanzamientos, exclusivos P-Bandai, eventos en México y movimientos de precio, en español y con la fuente siempre enlazada."
  schemas={schemas}
>
  <Breadcrumbs items={migas} />

  <div class="contenedor py-8">
    <h1 class="font-display text-3xl font-bold md:text-4xl">Noticias</h1>
    <p class="mt-4 max-w-3xl text-ink-muted">
      Redactamos cada nota y enlazamos siempre a la fuente original. Cuando el anuncio es global,
      le agregamos lo que falta: qué significa en pesos y si llega a México.
    </p>

    {notas.length === 0 ? (
      <p class="mt-8 text-ink-muted">Todavía no hay notas publicadas.</p>
    ) : (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {notas.map((n) => <TarjetaNoticia nota={n} />)}
      </div>
    )}
  </div>
</BaseLayout>

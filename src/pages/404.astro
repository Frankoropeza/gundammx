---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout titulo="Página no encontrada" descripcion="La página que buscas no existe." noindex>
  <section class="grid-page max-w-xl py-28 text-center">
    <p class="display text-7xl text-accent">404</p>
    <h1 class="mt-4 display text-2xl">Esta página no existe</h1>
    <p class="mt-4 text-ink-2">
      Puede que la ficha se haya movido o que el link esté mal escrito.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/tiendas/" class="btn-primary">Ver el directorio</a>
      <a href="/" class="btn-secondary">Ir al inicio</a>
    </div>
  </section>
</BaseLayout>

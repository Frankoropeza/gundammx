---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import DirectoryCard from '@components/DirectoryCard.astro';
import DirectoryFilters from '@components/DirectoryFilters.astro';
import LocationGrid from '@components/LocationGrid.astro';
import CategoryGrid from '@components/CategoryGrid.astro';
import { tiendasActivas, ciudadesConPagina, estadosConTiendas, categoriasConTiendas, indexable } from '@lib/directorio';
import { ESTADOS } from '@lib/estados';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

const tiendas = await tiendasActivas();
const todasCiudades = await ciudadesConPagina();
const ciudades = todasCiudades.filter((c) => indexable(c.total));
const porEstado = await estadosConTiendas();
const estados = ESTADOS.filter((e) => porEstado.has(e.slug)).map((e) => ({ slug: e.slug, total: porEstado.get(e.slug)! }));
const categorias = await categoriasConTiendas();

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Tiendas', href: '/tiendas/' }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, 'Tiendas de Gundam en México', tiendas.map((t) => ({ nombre: t.data.nombre, href: `/tienda/${t.id}/` }))),
];
import HubImagen from '@components/HubImagen.astro';
import imgTiendas from '../../assets/hub-tiendas.jpg';
---

<BaseLayout
  titulo="Tiendas Gundam México | Directorio verificado"
  descripcion={`Directorio de tiendas Gundam en México: ${tiendas.length} tiendas de Gunpla y model kits por estado y ciudad, con grados, envío nacional y verificación con fuente.`}
  schemas={schemas}
>
  <Breadcrumbs items={migas} />

  <HubImagen src={imgTiendas} id="hub-tiendas" />

  <div class="grid-page py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">Directorio</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-balance">Tiendas de Gundam en México</h1>
      <p class="mt-5 text-lg text-ink-2 text-pretty">
        {tiendas.length} tiendas. Cada ficha dice qué grados maneja, si envía a todo el país y con qué fuente
        comprobamos su oferta. La verificación no se cobra ni se vende.
      </p>
    </header>

    <nav aria-label="Atajos" class="mt-8 flex flex-wrap gap-2">
      <a href="/tiendas/verificadas/" class="tag hover:border-ink hover:text-ink">Solo verificadas</a>
      <a href="/tiendas/en-linea/" class="tag hover:border-ink hover:text-ink">Con envío nacional</a>
      {categorias.map((c) => <a href={`/tiendas/categoria/${c.slug}/`} class="tag hover:border-ink hover:text-ink">{c.nombre}</a>)}
    </nav>

    <div class="mt-10">
      <DirectoryFilters ciudades={todasCiudades} estados={estados.map((e) => e.slug)} />
    </div>

    <section class="mt-10" aria-labelledby="lista-tiendas">
      <h2 id="lista-tiendas" class="display text-2xl md:text-3xl">Tiendas Gundam verificadas por estado y ciudad</h2>
      <div class="mt-6 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
        {tiendas.map((t, i) => <DirectoryCard tienda={t} prioridad={i < 3} />)}
      </div>
    </section>

    <div class="mt-20 space-y-16">
      <LocationGrid ciudades={ciudades} estados={estados} />
      <section>
        <h2 class="eyebrow">Por tipo de tienda</h2>
        <div class="mt-4"><CategoryGrid categorias={categorias} /></div>
      </section>
    </div>
  </div>
</BaseLayout>

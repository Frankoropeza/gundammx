---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import DirectoryCard from '@components/DirectoryCard.astro';
import EmptyState from '@components/EmptyState.astro';
import LocationGrid from '@components/LocationGrid.astro';
import { tiendasActivas, estadosDe, ciudadesConPagina, indexable, UMBRAL_ESTADO } from '@lib/directorio';
import { ESTADOS, nombreEstado } from '@lib/estados';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const tiendas = await tiendasActivas();
  const ciudades = await ciudadesConPagina();
  // Sólo se compilan los estados donde hay al menos una tienda. Un estado sin
  // fichas no es una página: es un HTML vacío que sólo consume rastreo.
  return ESTADOS
    .map((e) => ({ e, propias: tiendas.filter((t) => estadosDe(t).includes(e.slug)) }))
    .filter(({ propias }) => propias.length > 0)
    .map(({ e, propias }) => ({
      params: { estado: e.slug },
      props: {
        tiendas: propias,
        ciudades: ciudades.filter((c) => c.estado === e.slug && indexable(c.total)),
      },
    }));
};

interface Props { tiendas: CollectionEntry<'tiendas'>[]; ciudades: { slug: string; nombre: string; estado: string; total: number }[] }
const { estado } = Astro.params;
const { tiendas, ciudades } = Astro.props;
const nombre = nombreEstado(estado!);
/**
 * El sufijo " | GUNDAMMX" que añade SEO.astro son 11 caracteres. Con
 * topónimos largos, la cola "| Gunpla original" pasa de los 60 visibles en
 * SERP, así que se omite en vez de dejar que Google truncue el título.
 */
const tituloBase = `Tiendas Gundam en ${nombre}`;
const titulo = tituloBase.length + ' | Gunpla original | GUNDAMMX'.length <= 60
  ? `${tituloBase} | Gunpla original`
  : tituloBase;
// Los estados sin fichas ya no se compilan (F2), pero un estado puede quedarse
// vacío si todas sus tiendas se marcan como cerradas. La rama se conserva por eso.
const sinContenido = tiendas.length === 0;

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Tiendas', href: '/tiendas/' }, { nombre, href: `/tiendas/${estado}/` }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, `Tiendas de Gundam en ${nombre}`, tiendas.map((t) => ({ nombre: t.data.nombre, href: `/tienda/${t.id}/` }))),
];
---

<BaseLayout
  titulo={titulo}
  descripcion={`Tiendas Gundam en ${nombre}: dónde comprar Gunpla y model kits originales, con grados en catálogo, cobertura de envío y verificación con fuente y fecha.`}
  noindex={tiendas.length < UMBRAL_ESTADO}
  schemas={schemas}
>
  <Breadcrumbs items={migas} />
  <div class="grid-page py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">Estado</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-balance">Tiendas de Gundam en {nombre}</h1>
      {!sinContenido && <p class="mt-5 font-mono text-sm text-ink-2 tabular">{tiendas.length} {tiendas.length === 1 ? 'tienda' : 'tiendas'} en el directorio</p>}
    </header>

    {sinContenido ? (
      <div class="mt-10 max-w-2xl">
        <EmptyState
          titulo={`Todavía no tenemos tiendas verificadas en ${nombre}`}
          texto="Preferimos decirlo a llenar la página con resultados que no comprobamos. Mientras tanto, las tiendas con envío nacional llegan a todo el estado."
          accion={{ texto: 'Ver tiendas con envío nacional', href: '/tiendas/en-linea/' }}
        />
        <p class="mt-4 text-sm text-ink-2">¿Conoces una o tienes tienda aquí? <a href="/alta-de-tienda/" class="link">Dala de alta</a> y la verificamos.</p>
      </div>
    ) : (
      <>
        <h2 class="display mt-12 text-2xl md:text-3xl">{`Tiendas Gundam verificadas en ${nombre}`}</h2>
        <div class="mt-6 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
          {tiendas.map((t, i) => <DirectoryCard tienda={t} prioridad={i < 3} />)}
        </div>
        {ciudades.length > 0 && <div class="mt-16"><LocationGrid ciudades={ciudades} titulo={`Ciudades de ${nombre} con página propia`} /></div>}
      </>
    )}
  </div>
</BaseLayout>

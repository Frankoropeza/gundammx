---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import DirectoryCard from '@components/DirectoryCard.astro';
import { tiendasEnLinea } from '@lib/directorio';
import { pesos } from '@lib/precio';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

const tiendas = await tiendasEnLinea();
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Tiendas', href: '/tiendas/' }, { nombre: 'Con envío nacional', href: '/tiendas/en-linea/' }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, 'Tiendas de Gunpla con envío a todo México', tiendas.map((t) => ({ nombre: t.data.nombre, href: `/tienda/${t.id}/` }))),
];
---

<BaseLayout
  titulo="Tiendas de Gunpla con envío a todo México"
  descripcion="Comparativa de tiendas mexicanas que envían Gunpla a todo el país: paqueterías, umbral de envío gratis, preventas y verificación."
  schemas={schemas}
>
  <Breadcrumbs items={migas} />
  <div class="grid-page py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">Envío nacional</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-balance">Tiendas con envío a todo México</h1>
      <p class="mt-5 text-lg text-ink-2 text-pretty">Si no hay tienda física en tu ciudad, esta es la lista. Comparamos paqueterías, umbral de envío gratis y si manejan preventa: donde más dudas genera el comercio de kits en México.</p>
    </header>

    <div class="table-scroll mt-10">
      <table>
        <caption class="sr-only">Comparativa de envíos</caption>
        <thead><tr><th scope="col">Tienda</th><th scope="col">Paqueterías</th><th scope="col">Envío gratis desde</th><th scope="col">Preventa</th><th scope="col">Verificación</th></tr></thead>
        <tbody>
          {tiendas.map((t) => (
            <tr>
              <td><a href={`/tienda/${t.id}/`} class="link-quiet font-medium">{t.data.nombre}</a></td>
              <td class="text-ink-2">{t.data.paqueterias.join(', ') || '—'}</td>
              <td class="font-mono text-ink-2 tabular">{t.data.envio_gratis_desde ? pesos(t.data.envio_gratis_desde) : '—'}</td>
              <td class="text-ink-2">{t.data.maneja_preventa ? 'Sí' : '—'}</td>
              <td class="text-ink-2">{t.data.verificacion.estado === 'verificada' ? 'Verificada' : 'Sin verificar'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {tiendas.map((t) => <DirectoryCard tienda={t} />)}
    </div>
  </div>
</BaseLayout>

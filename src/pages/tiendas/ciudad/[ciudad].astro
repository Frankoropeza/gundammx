---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import DirectoryCard from '@components/DirectoryCard.astro';
import DirectoryFilters from '@components/DirectoryFilters.astro';
import TablaTiendas from '@components/TablaTiendas.astro';
import FAQ from '@components/FAQ.astro';
import { tiendasActivas, ciudadesDe, ciudadesConPagina, indexable } from '@lib/directorio';
import { nombreEstado, slugificar } from '@lib/estados';
import { schemaListado, schemaMigaDePan, schemaFAQ } from '@lib/seo';
import { fechaLarga } from '@lib/precio';

export const getStaticPaths: GetStaticPaths = async () => {
  const tiendas = await tiendasActivas();
  // Toda ciudad con al menos una tienda lleva página; por debajo del umbral
  // va con `noindex` y se activa sola al llegar a dos. No se compilan páginas
  // de cero fichas, pero `ciudadesConPagina()` nunca devuelve ninguna.
  const ciudades = await ciudadesConPagina();
  return ciudades.map((c) => ({
    params: { ciudad: c.slug },
    props: { nombre: c.nombre, estado: c.estado, total: c.total, tiendas: tiendas.filter((t) => ciudadesDe(t).some((x) => x.slug === c.slug)) },
  }));
};

interface Props { nombre: string; estado: string; total: number; tiendas: CollectionEntry<'tiendas'>[] }
const { ciudad } = Astro.params;
const { nombre, estado, total, tiendas } = Astro.props;

const eventos = (await getCollection('eventos'))
  .filter((e) => slugificar(e.data.ciudad) === ciudad && (e.data.fecha_fin ?? e.data.fecha_inicio) >= new Date())
  .sort((a, b) => a.data.fecha_inicio.getTime() - b.data.fecha_inicio.getTime());

const conEnvio = tiendas.filter((t) => t.data.envio_nacional).length;
const conPreventa = tiendas.filter((t) => t.data.maneja_preventa).length;
const verificadas = tiendas.filter((t) => t.data.verificacion.estado === 'verificada').length;

const faq = [
  { pregunta: `¿Cómo sé que una tienda de ${nombre} vende producto original?`, respuesta: 'Cada ficha declara el origen del producto y la fuente con la que lo comprobamos. Cuando no pudimos verificarlo, la etiqueta dice «origen no verificado».' },
  { pregunta: `¿Cuánto debería costar un kit en ${nombre}?`, respuesta: 'En el canal oficial mexicano el precio ronda 2.3 veces el precio de lista japonés. En cada ficha de kit publicamos el rango esperado en pesos para detectar sobreprecio.' },
  { pregunta: `Falta una tienda de ${nombre}`, respuesta: 'Mándanosla desde la página de alta y la verificamos antes de publicarla. Aparecer es gratis.' },
];

// Misma regla que la página de estado: con topónimos largos se omite la cola
// para no pasar de los 60 caracteres visibles en SERP.
const tituloBase = `Tiendas Gundam en ${nombre}`;
const titulo = tituloBase.length + ' | Gunpla original | GUNDAMMX'.length <= 60
  ? `${tituloBase} | Gunpla original`
  : tituloBase;

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [
  { nombre: 'Tiendas', href: '/tiendas/' },
  { nombre: nombreEstado(estado), href: `/tiendas/${estado}/` },
  { nombre, href: `/tiendas/ciudad/${ciudad}/` },
];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, `Tiendas de Gundam en ${nombre}`, tiendas.map((t) => ({ nombre: t.data.nombre, href: `/tienda/${t.id}/` }))),
  ...(indexable(total) ? [schemaFAQ(faq)] : []),
];
---

<BaseLayout
  titulo={titulo}
  descripcion={`${total} ${total === 1 ? 'tienda Gundam' : 'tiendas Gundam'} en ${nombre}, ${nombreEstado(estado)}: dónde comprar Gunpla original, con grados, envío, preventas y verificación con fuente.`}
  noindex={!indexable(total)}
  schemas={schemas}
>
  <Breadcrumbs items={migas} />
  <div class="grid-page py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">{nombreEstado(estado)}</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-balance">Tiendas de Gundam en {nombre}</h1>
      <p class="mt-5 font-mono text-sm text-ink-2 tabular">
        {total} {total === 1 ? 'tienda' : 'tiendas'} · {verificadas} verificadas · {conEnvio} con envío nacional · {conPreventa} con preventa
      </p>
    </header>

    {total > 3 && <div class="mt-10"><DirectoryFilters ciudades={[]} estados={[]} mostrarCiudad={false} mostrarEstado={false} /></div>}

    <div class="mt-8 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
      {tiendas.map((t, i) => <DirectoryCard tienda={t} prioridad={i < 3} />)}
    </div>

    {total > 1 && (
      <section class="mt-16" aria-labelledby="comp-h">
        <h2 id="comp-h" class="display text-2xl">Comparativa</h2>
        <div class="mt-5"><TablaTiendas tiendas={tiendas} /></div>
      </section>
    )}

    {eventos.length > 0 && (
      <section class="mt-16" aria-labelledby="ev-h">
        <h2 id="ev-h" class="display text-2xl">Próximos eventos en {nombre}</h2>
        <ul class="mt-5 divide-y divide-line border-y border-line">
          {eventos.map((e) => (
            <li class="py-4">
              <p class="font-medium">{e.data.nombre}</p>
              <p class="mt-1 font-mono text-xs text-ink-3">{fechaLarga(e.data.fecha_inicio)}{e.data.sede && ` · ${e.data.sede}`}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-16 max-w-3xl"><FAQ items={faq} /></div>
  </div>
</BaseLayout>

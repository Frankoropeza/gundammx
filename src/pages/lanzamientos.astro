---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { ETIQUETAS_TIPO, LANZAMIENTOS, LANZAMIENTOS_VERIFICADO, type Lanzamiento } from '@config/lanzamientos';
import { fechaLarga } from '@lib/precio';
import { schemaListado, schemaMigaDePan } from '@lib/seo';

const MESES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];

const fechaFin = (lanzamiento: Lanzamiento) => {
  const [anio, mes, dia] = lanzamiento.fecha.split('-').map(Number);
  if (lanzamiento.precision === 'mes') return new Date(Date.UTC(anio, mes, 0, 23, 59, 59, 999));
  if (lanzamiento.precision === 'anio') return new Date(Date.UTC(anio, 11, 31, 23, 59, 59, 999));
  return new Date(Date.UTC(anio, mes - 1, dia, 23, 59, 59, 999));
};

const fechaLegible = (lanzamiento: Lanzamiento) => {
  if (lanzamiento.precision === 'dia') return fechaLarga(lanzamiento.fecha);
  const [anio, mes] = lanzamiento.fecha.split('-').map(Number);
  return lanzamiento.precision === 'mes' ? `${MESES[mes - 1]} de ${anio}` : String(anio);
};

const ordenar = (a: Lanzamiento, b: Lanzamiento) =>
  fechaFin(a).getTime() - fechaFin(b).getTime() || a.tipo.localeCompare(b.tipo, 'es');

const agrupar = (items: Lanzamiento[]) => {
  const grupos = new Map<string, Lanzamiento[]>();
  const ordenados = [
    ...items.filter((lanzamiento) => lanzamiento.precision !== 'anio').sort(ordenar),
    ...items.filter((lanzamiento) => lanzamiento.precision === 'anio').sort(ordenar),
  ];
  for (const lanzamiento of ordenados) {
    const etiqueta = lanzamiento.precision === 'anio'
      ? `${lanzamiento.fecha}, sin fecha exacta`
      : `${MESES[Number(lanzamiento.fecha.slice(5, 7)) - 1]} de ${lanzamiento.fecha.slice(0, 4)}`;
    grupos.set(etiqueta, [...(grupos.get(etiqueta) ?? []), lanzamiento]);
  }
  return [...grupos.entries()].map(([titulo, lanzamientos]) => ({ titulo, lanzamientos, id: slug(titulo) }));
};

const slug = (texto: string) => texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const fechaBuild = new Date();
const proximos = LANZAMIENTOS.filter((lanzamiento) => fechaFin(lanzamiento) >= fechaBuild);
const pasados = LANZAMIENTOS.filter((lanzamiento) => fechaFin(lanzamiento) < fechaBuild);
const gruposProximos = agrupar(proximos);
const gruposPasados = agrupar(pasados);

const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Lanzamientos', href: '/lanzamientos/' }];
const schemas = [
  schemaMigaDePan(base, migas),
  schemaListado(base, 'Próximos lanzamientos de Gundam', proximos.map((lanzamiento) => ({
    nombre: lanzamiento.titulo,
    href: '/lanzamientos/',
  }))),
];
---

<BaseLayout
  titulo="Lanzamientos Gundam: calendario de Gunpla, anime y juegos"
  descripcion="Calendario mensual de nuevos Gunpla, estrenos de anime y películas, videojuegos y sets del Gundam Card Game, con fechas de fuentes oficiales."
  schemas={schemas}
>
  <Breadcrumbs items={migas} />

  <div class="grid-page py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">Calendario</p>
      <h1 class="display mt-3 text-4xl md:text-5xl">Calendario de lanzamientos de Gundam</h1>
      <p class="mt-5 text-lg text-ink-2 text-pretty">
        Reunimos lanzamientos de Gunpla, anime, cine, videojuegos y el Gundam Card Game con la fecha que publica cada fuente oficial.
      </p>
      <p class="mt-3 text-ink-2 text-pretty">
        Los precios son los publicados por Bandai en Japón o Estados Unidos; no son precio en México. Consulta
        <a href="/articulos/cuanto-cuesta-un-gunpla-en-mexico/" class="link">cuánto cuesta un Gunpla en México</a>.
      </p>
      <p class="mt-5 font-mono text-xs text-ink-3">Verificado el {fechaLarga(LANZAMIENTOS_VERIFICADO)}</p>
    </header>

    <section class="mt-12" aria-labelledby="proximos-lanzamientos">
      <h2 id="proximos-lanzamientos" class="display text-2xl md:text-3xl">Próximos lanzamientos</h2>
      {gruposProximos.map((grupo) => (
        <section class="mt-8" aria-labelledby={`grupo-${grupo.id}`}>
          <h3 id={`grupo-${grupo.id}`} class="class-line">{grupo.titulo}</h3>
          <ul class="mt-4 space-y-4">
            {grupo.lanzamientos.map((lanzamiento) => (
              <li class="card p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="tag">{ETIQUETAS_TIPO[lanzamiento.tipo]}</span>
                  <p class="font-mono text-sm text-ink-2">{fechaLegible(lanzamiento)}</p>
                </div>
                <h4 class="display mt-3 text-lg">{lanzamiento.titulo}</h4>
                {lanzamiento.detalle && <p class="mt-2 text-sm text-ink-2">{lanzamiento.detalle}</p>}
                {lanzamiento.precio && (
                  <p class="mt-3 text-sm text-ink-2">
                    Precio publicado: {lanzamiento.precio.monto} · {lanzamiento.precio.impuestos === 'incluidos' ? 'impuestos incluidos' : 'según calendario de Bandai Hobby'}
                  </p>
                )}
                {lanzamiento.region && <p class="mt-1 text-sm text-ink-2">Región: {lanzamiento.region}</p>}
                <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                  <a href={lanzamiento.fuente.url} class="link" rel="noopener" target="_blank">Fuente: {lanzamiento.fuente.nombre}</a>
                  {lanzamiento.enlace && <a href={lanzamiento.enlace} class="link">Leer más</a>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    {gruposPasados.length > 0 && (
      <details class="mt-12 border-t border-line pt-6">
        <summary class="display cursor-pointer text-xl">Ya salieron</summary>
        {gruposPasados.map((grupo) => (
          <section class="mt-8" aria-labelledby={`pasados-${grupo.id}`}>
            <h3 id={`pasados-${grupo.id}`} class="class-line">{grupo.titulo}</h3>
            <ul class="mt-4 space-y-4">
              {grupo.lanzamientos.map((lanzamiento) => (
                <li class="card p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="tag">{ETIQUETAS_TIPO[lanzamiento.tipo]}</span>
                    <p class="font-mono text-sm text-ink-2">{fechaLegible(lanzamiento)}</p>
                  </div>
                  <h4 class="display mt-3 text-lg">{lanzamiento.titulo}</h4>
                  {lanzamiento.detalle && <p class="mt-2 text-sm text-ink-2">{lanzamiento.detalle}</p>}
                  {lanzamiento.precio && (
                    <p class="mt-3 text-sm text-ink-2">
                      Precio publicado: {lanzamiento.precio.monto} · {lanzamiento.precio.impuestos === 'incluidos' ? 'impuestos incluidos' : 'según calendario de Bandai Hobby'}
                    </p>
                  )}
                  {lanzamiento.region && <p class="mt-1 text-sm text-ink-2">Región: {lanzamiento.region}</p>}
                  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                    <a href={lanzamiento.fuente.url} class="link" rel="noopener" target="_blank">Fuente: {lanzamiento.fuente.nombre}</a>
                    {lanzamiento.enlace && <a href={lanzamiento.enlace} class="link">Leer más</a>}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </details>
    )}

    <aside class="mt-12 border-t border-line pt-6">
      <h2 class="class-line">Sigue el archivo</h2>
      <p class="mt-3 text-sm text-ink-2">
        Consulta las <a href="/noticias/" class="link">noticias</a>, los <a href="/eventos/" class="link">eventos en México</a> y los <a href="/articulos/categoria/juegos/" class="link">artículos sobre juegos</a>.
      </p>
    </aside>
  </div>
</BaseLayout>

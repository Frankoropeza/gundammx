---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PageHeader from '@components/PageHeader.astro';
import UniverseNavigator from '@components/UniverseNavigator.astro';
import { universosConContenido } from '@lib/archivo';
import { schemaColeccion, schemaMigaDePan } from '@lib/seo';
const universos = await universosConContenido();
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Universos', href: '/universos/' }];
const schemas = [schemaMigaDePan(base, migas), schemaColeccion(base, { nombre: 'Universos de Gundam', descripcion: 'Las líneas temporales de la franquicia.', items: universos.map((u) => ({ nombre: u.data.nombre, href: `/universos/${u.id}/` })) })];
import HubImagen from '@components/HubImagen.astro';
import imgUniversos from '../../assets/hub-universos.jpg';
---
<BaseLayout titulo="Universos de Gundam | Las siete líneas temporales" descripcion="Explora los universos de Gundam y sus series de entrada: Universal Century, Cosmic Era, After Colony y cuatro líneas temporales más." schemas={schemas}>
  <Breadcrumbs items={migas} />

  <PageHeader
    sello="Archivo · Líneas temporales"
    titulo="Universos"
    entrada="Gundam no es una historia continua sino siete calendarios independientes. Solo uno de ellos —el Universal Century— exige seguir un orden."
  />
  <HubImagen src={imgUniversos} id="hub-universos" />
  <UniverseNavigator universos={universos} />
</BaseLayout>

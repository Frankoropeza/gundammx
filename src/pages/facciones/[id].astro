---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import MetadataRow from '@components/MetadataRow.astro';
import RelatedContent from '@components/RelatedContent.astro';
import { entradasPorIds, nombreUniverso, FORMATO } from '@lib/archivo';
import { fechaLarga } from '@lib/precio';
import { schemaFicha, schemaMigaDePan } from '@lib/seo';

export const getStaticPaths = (async () => {
  const facciones = await getCollection('factions');
  const [ms, pilotos] = await Promise.all([getCollection('mobile-suits'), getCollection('pilots')]);
  return Promise.all(facciones.map(async (f) => ({
    params: { id: f.id },
    props: {
      faccion: f,
      series: await entradasPorIds('series', f.data.series),
      ms: ms.filter((m) => m.data.faccion === f.id),
      pilotos: pilotos.filter((p) => p.data.facciones.includes(f.id)),
    },
  })));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { faccion, series, ms, pilotos } = Astro.props;
const d = faccion.data;
const { Content } = await render(faccion);
const base = { site: Astro.site, url: Astro.url.pathname };
const migas = [{ nombre: 'Universos', href: '/universos/' }, { nombre: nombreUniverso(d.universo), href: `/universos/${d.universo}/` }, { nombre: d.nombre, href: `/facciones/${faccion.id}/` }];
const schemas = [schemaMigaDePan(base, migas), schemaFicha(base, { nombre: d.nombre, descripcion: d.resumen, fecha: d.actualizado })];
---
<BaseLayout noindex={d.estado_editorial === 'borrador'} titulo={`${d.nombre}: ${d.tipo.toLowerCase()} en ${nombreUniverso(d.universo)}`} descripcion={d.resumen} tipo="article" schemas={schemas}>
  <Breadcrumbs items={migas} />
  <article class="grid-page grid gap-10 py-10 lg:grid-cols-12">
    <header class="lg:col-span-8">
      <p class="archive-code">{d.codigo}</p>
      <p class="class-line mt-4">{d.tipo} · {nombreUniverso(d.universo)}</p>
      <h1 class="display mt-4 text-4xl md:text-5xl">{d.nombre}</h1>
      <p class="mt-5 max-w-prose text-lg text-ink-2 text-pretty">{d.resumen}</p>
      <MetadataRow class="mt-8" items={[{ etiqueta: 'Universo', valor: nombreUniverso(d.universo), href: `/universos/${d.universo}/` }, { etiqueta: 'Aparece en', valor: series.map((s) => s.data.titulo).join(', ') }]} />
    </header>
    <div class="prose-ed lg:col-span-7"><Content /></div>
    <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-pagefind-ignore>
      <RelatedContent titulo="Obras" items={series.map((s) => ({ eyebrow: `${s.data.anio} · ${FORMATO[s.data.formato]}`, titulo: s.data.titulo, href: `/series/${s.id}/` }))} />
      <RelatedContent titulo="Mobile suits" items={ms.map((m) => ({ codigo: m.data.designacion, eyebrow: 'Mobile suit', titulo: m.data.nombre, href: `/mobile-suits/${m.id}/` }))} />
      <RelatedContent titulo="Personajes" items={pilotos.map((p) => ({ eyebrow: p.data.rol, titulo: p.data.nombre, href: `/personajes/${p.id}/` }))} />
      <section class="border-t border-line pt-6"><h2 class="class-line">Fuentes</h2><ul class="mt-3 space-y-1">{d.fuentes.map((f) => <li class="truncate text-sm"><a href={f} class="link" rel="nofollow noopener" target="_blank">{f}</a></li>)}</ul><p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-3">Actualizado {fechaLarga(d.actualizado)}</p></section>
    </aside>
  </article>
</BaseLayout>
